<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Approval types (categories): visible only to the users / groups chosen on them.
         Nothing chosen = visible to everybody. Approvals managers and administrators see all. -->
    <record id="rule_ad_approval_category_manager" model="ir.rule">
        <field name="name">Approval types: managers see all</field>
        <field name="model_id" ref="approvals.model_approval_category"/>
        <field name="groups" eval="[(4, ref('approvals.group_approval_manager')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_ad_approval_category_user" model="ir.rule">
        <field name="name">Approval types: only allowed users / groups</field>
        <field name="model_id" ref="approvals.model_approval_category"/>
        <field name="groups" eval="[(4, ref('approvals.group_approval_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">['|', '|', '&amp;', ('ad_user_ids', '=', False), ('ad_group_ids', '=', False), ('ad_user_ids', 'in', [user.id]), ('ad_group_ids', 'in', user.all_group_ids.ids)]</field>
    </record>
</odoo>
