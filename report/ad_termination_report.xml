<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_termination" model="ir.actions.report">
        <field name="name">أمر انهاء خدمات (AD-WI-FM-06-10)</field>
        <field name="model">ad.termination.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_termination</field>
        <field name="print_report_name">'Termination order - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_termination_order" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_ad_termination">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="pg" t-value="1" /><t t-set="pgs" t-value="1" />
                <div class="ad-page">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <t t-set="seq" t-value="doc.name if doc.name != '/' else ''" />
                    <t t-set="dt" t-value="doc.date" />
                    <t t-set="rounded" t-value="False" />
                    <t t-call="abnaa_dijlah_hr.ad_form_seqrow" />
                    <div class="ad-c ad-b ad-u" style="font-size:11pt; margin-top:14mm;"><t t-out="h.t('termination', 1, 'امر انهاء خدمات')" /></div>
                    <div style="font-size:11.5pt; line-height:2.3; margin-top:12mm;">
                        <t t-out="h.t('termination', 2, 'بموجب الصلاحيات المخولة لنا تقرر انهاء خدمات السيد (')" /> <span class="ad-fill" t-out="doc.employee_id.name" /> <t t-out="h.t('termination', 3, ') بصفة (')" /> <span class="ad-fill" t-out="doc.capacity" /> <t t-out="h.t('termination', 4, ') المنسوب الى موقع (')" /> <span class="ad-fill" t-out="doc.site_id.name" /> <t t-out="h.t('termination', 5, ') اعتبارا من تاريخ (')" /> <span class="ad-d" t-out="h.d3(doc.effective_date)" /> ).
                    </div>
                    <table class="ad-nb" style="margin-top:46mm;">
                        <tr>
                            <td style="width:52%;" />
                            <td class="ad-c ad-b" style="font-size:11pt; line-height:2.2;">
                                <div t-out="doc.company_id.ad_md_title" />
                                <div t-out="doc.company_id.ad_md_name" />
                                <div t-out="h.month_year_ar(doc.date)" />
                            </td>
                        </tr>
                    </table>
                    <div class="ad-copy" style="margin-top:22mm; line-height:1.5;">
                        <u><t t-out="h.t('termination', 6, 'نسخة منه الى:')" /></u><br />
                        <t t-out="h.t('termination', 7, '- القسم المالي / للتفضل بالاطلاع واتخاذ ما يلزم.. مع التقدير')" /><br />
                        <t t-out="h.t('termination', 8, '- قسم الموارد البشرية/ للتفضل بالاطلاع واتخاذ مايلزم .. مع التقدير')" /><br />
                        <t t-out="h.t('termination', 9, '- القسم المعني / لاتخاذ ما يلزم ... مع التقدير')" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>