<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_interview" model="ir.actions.report">
        <field name="name">استمارة تقييم المقابلة (AD-WI-FM-06-01)</field>
        <field name="model">ad.interview</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_interview</field>
        <field name="print_report_name">'Interview rating - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_interview" />
        <field name="binding_type">report</field>
    </record>

    <template id="ad_interview_bar">
        <div class="ad-b" style="background:#1f73c4; color:#fff; font-size:10pt; padding:0.8mm 2mm; margin-top:3mm;"><t t-out="title" /></div>
    </template>

    <template id="ad_interview_lvl">
        
        <t t-foreach="[('excellent', 'ممتاز'), ('very_good', 'جيد جدا'), ('good', 'جيد'), ('weak', 'ضعيف'), ('very_weak', 'ضعيف جدا')]" t-as="l">
            <span t-out="h.box(val == l[0])" /> <span t-out="l[1]" />  
        </t>
    </template>

    <template id="report_ad_interview">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="pgs" t-value="5" />
                <t t-set="crit" t-value="[('1', 'التعليم والمؤهلات المهنية', 'طريقة القياس: وثائق ثبوتية لتأكيد مستوى التعليم والمؤهلات'), ('2', 'الخبرة العملية', 'طريقة القياس: وثائق مرجعية من أماكن العمل السابقة'), ('3', 'مهارات قيادة العجلات', 'طريقة القياس: وثيقة ثبوتية ( إجازة السوق)'), ('4', 'المظهر والانضباط العام', 'طريقة القياس: ملاحظة مباشرة (ان يكون الهندام مناسب)'), ('5', 'اللياقة البدنية والتحمل', 'طريقة القياس: اختبارات ميدانية بسيطة (جري، تمرين ضغط، حمل اوزان)'), ('6', 'الثبات الانفعالي وضبط النفس', 'طريقة القياس: طرح مجموعة من الأسئلة السلوكية'), ('7', 'الوعي الأمني والملاحظة', 'طريقة القياس: عرض صورة او فديو ومن ثم طرح مجموعة من الأسئلة')]" />

                
                <t t-set="pg" t-value="1" />
                <div class="ad-page" style="font-size:9pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <div class="ad-b" style="margin-top:2mm;"><t t-out="h.t('interview', 1, 'الرقم:')" /> <span t-out="doc.name if doc.name != '/' else ''" />         <t t-out="h.t('interview', 2, 'تاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.date)" /></div>
                    <table class="ad-t" style="margin-top:1mm;">
                        <tr><td class="ad-b" style="width:16%;"><t t-out="h.t('interview', 3, 'اسم المرشح')" /></td><td t-out="doc.candidate_name" /><td class="ad-b" style="width:16%;"><t t-out="h.t('interview', 4, 'تاريخ الميلاد')" /></td><td class="ad-d" style="width:20%;" t-out="h.d3(doc.birth_date)" /></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 5, 'رقم الهاتف')" /></td><td colspan="3" class="ad-d" t-out="doc.phone" /></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 6, 'عنوان السكن')" /></td><td colspan="3"><span class="ad-b"><t t-out="h.t('interview', 7, 'المحافظة:')" /></span> <span t-out="doc.governorate" />    <span class="ad-b"><t t-out="h.t('interview', 8, 'الناحية:')" /></span> <span t-out="doc.area" />    <span class="ad-b"><t t-out="h.t('interview', 9, 'الحي:')" /></span> <span t-out="doc.district" /></td></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 10, 'تاريخ المقابلة')" /></td><td colspan="3" class="ad-d" t-out="h.d3(doc.interview_date)" /></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 11, 'المسمى الوظيفي')" /></td><td colspan="3" t-out="doc.job_title" /></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 12, 'اسم جهة الترشيح')" /></td><td colspan="3" t-out="doc.referral" /></tr>
                    </table>

                    <t t-set="title" t-value="'معايير التقييم:'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <table class="ad-t ad-c"><tr class="ad-b"><td><t t-out="h.t('interview', 13, 'غير مستوفي')" /></td><td><t t-out="h.t('interview', 14, 'دون المتطلبات')" /></td><td><t t-out="h.t('interview', 15, 'يلبي المتطلبات')" /></td><td><t t-out="h.t('interview', 16, 'يتجاوز المتطلبات')" /></td><td><t t-out="h.t('interview', 17, 'ممتاز')" /></td></tr>
                        <tr><td>0-3</td><td>4-5</td><td>6-7</td><td>8-9</td><td>10</td></tr></table>

                    <t t-set="title" t-value="'تقييم المؤهلات والجدارات العامة:'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <table class="ad-t" style="font-size:8.5pt;">
                        <tr><td style="width:30%;" /><td class="ad-b ad-c" colspan="2"><t t-out="h.t('interview', 18, 'التقييم')" /></td></tr>
                        <t t-foreach="crit" t-as="c">
                            <t t-set="ln" t-value="doc.score_ids.filtered(lambda s: s.criterion == c[0])[:1]" />
                            <tr style="height:11mm;">
                                <td class="ad-b" t-out="c[0] + '- ' + c[1]" />
                                <td style="width:30%;"><span class="ad-b"><t t-out="h.t('interview', 19, 'التعليقات:')" /></span> <span t-out="ln.comments if ln else ''" /></td>
                                <td style="width:36%;"><span t-out="c[2]" /> <b t-if="ln and ln.score">   (<t t-out="ln.score" />)</b></td>
                            </tr>
                        </t>
                        <t t-set="lv" t-value="[('درجة اتقان اللغة العربية', [('قراءة', doc.ar_read), ('كتابة', doc.ar_write), ('محادثة', doc.ar_speak)]), ('درجة اتقان اللغة الإنكليزية', [('قراءة', doc.en_read), ('كتابة', doc.en_write), ('محادثة', doc.en_speak)])]" />
                        <t t-foreach="lv" t-as="g">
                            <t t-foreach="g[1]" t-as="r">
                                <tr style="font-size:8pt;">
                                    <td t-if="r_index == 0" rowspan="3" class="ad-b" t-out="g[0]" />
                                    <td colspan="2"><b t-out="r[0]" />   <t t-set="val" t-value="r[1]" /><t t-call="abnaa_dijlah_hr.ad_interview_lvl" /></td>
                                </tr>
                            </t>
                        </t>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 20, 'درجة التقييم العام')" /></td><td colspan="2" class="ad-b" t-out="doc.overall_score or ''" /></tr>
                    </table>
                </div>

                
                <t t-set="pg" t-value="2" />
                <div class="ad-page" style="font-size:9pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <t t-set="title" t-value="'التقييم الصحي'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <table class="ad-t">
                        <tr><td class="ad-b" style="width:22%;"><t t-out="h.t('interview', 21, 'الوضع الصحي العام')" /></td><td><t t-set="val" t-value="doc.health_general" /><t t-call="abnaa_dijlah_hr.ad_interview_lvl" /></td></tr>
                        <tr><td class="ad-b"><t t-out="h.t('interview', 22, 'الوزن:')" /> <span t-out="doc.weight" /></td><td class="ad-b"><t t-out="h.t('interview', 23, 'الطول:')" /> <span t-out="doc.height" /></td></tr>
                        <tr><td colspan="2" style="height:22mm; vertical-align:top;"><span class="ad-b"><t t-out="h.t('interview', 24, 'اذكر الامراض المزمنة والمعدية التي تعاني منها:')" /></span><div t-out="doc.chronic_diseases" style="white-space:pre-line;" /></td></tr>
                    </table>
                    <table class="ad-t" style="margin-top:-1px;">
                        <t t-foreach="range(3)" t-as="i">
                            <t t-set="sg" t-value="doc.surgery_ids[i] if i &lt; len(doc.surgery_ids) else False" />
                            <tr>
                                <td t-if="i == 0" rowspan="3" class="ad-b" style="width:22%;"><t t-out="h.t('interview', 25, 'العمليات جراحية قمت بها')" /></td>
                                <td><span class="ad-b"><t t-out="h.t('interview', 26, 'نوع العملية:')" /></span> <span t-if="sg" t-out="sg.name" /></td>
                                <td style="width:30%;"><span class="ad-b"><t t-out="h.t('interview', 27, 'التاريخ:')" /></span> <span class="ad-d" t-if="sg" t-out="h.d3(sg.date)" /></td>
                            </tr>
                        </t>
                    </table>
                    <t t-set="hq" t-value="[('هل تتعاطى أي نوع من أنواع الأدوية او العقاقير بشكل دوري او مستمر', doc.q_medication), ('هل قمت بعمل وشم على أي جزء ظاهر من الجسم', doc.q_tattoo), ('هل من المخطط او المفترض ان تخضع لعلاج او عمليات جراحية في المستقبل المنظور', doc.q_planned_surgery), ('هل تخضع لبرنامج رعاية', doc.q_care_program)]" />
                    <table class="ad-t" style="margin-top:-1px;">
                        <t t-foreach="hq" t-as="q"><tr><td t-out="q[0]" /><td style="width:14%;"><t t-out="h.t('interview', 28, 'نعم')" /> <span t-out="h.box(q[1] == 'yes')" /></td><td style="width:14%;"><t t-out="h.t('interview', 29, 'كلا')" /> <span t-out="h.box(q[1] == 'no')" /></td></tr></t>
                    </table>
                    <t t-set="title" t-value="'التقييم الامني'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <t t-set="sq" t-value="[('هل لك صلة بالميليشيات او تنظيمات او احزاب', doc.q_party), ('هل سبق وان حكم عليك بجريمة او جنحة او جناية', doc.q_convicted), ('هل يوجد ضدك قضايا منظورة في المحاكم او الجهات القضائية', doc.q_pending_case)]" />
                    <table class="ad-t">
                        <t t-foreach="sq" t-as="q"><tr><td t-out="q[0]" /><td style="width:14%;"><t t-out="h.t('interview', 30, 'نعم')" /> <span t-out="h.box(q[1] == 'yes')" /></td><td style="width:14%;"><t t-out="h.t('interview', 31, 'كلا')" /> <span t-out="h.box(q[1] == 'no')" /></td></tr></t>
                    </table>
                    <div class="ad-c" style="border:1px solid #000; border-top:none; padding:0.8mm;"><t t-out="h.t('interview', 32, 'يرجى ذكر ثلاثة اشخاص معرفين يمكن للشركة التواصل معهم')" /></div>
                    <table class="ad-t" style="margin-top:-1px;">
                        <tr class="ad-b"><td><t t-out="h.t('interview', 33, 'اسم المعرف')" /></td><td><t t-out="h.t('interview', 34, 'العلاقة')" /></td><td><t t-out="h.t('interview', 35, 'رقم الهاتف')" /></td></tr>
                        <t t-foreach="range(3)" t-as="i">
                            <t t-set="rf" t-value="doc.reference_ids[i] if i &lt; len(doc.reference_ids) else False" />
                            <tr style="height:6mm;"><td t-out="rf.name if rf else ''" /><td t-out="rf.relation if rf else ''" /><td class="ad-d" t-out="rf.phone if rf else ''" /></tr>
                        </t>
                    </table>
                    <t t-set="title" t-value="'الموافقات:'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <table class="ad-t ad-c">
                        <tr class="ad-b"><td><t t-out="h.t('interview', 36, 'الاسم')" /></td><td><t t-out="h.t('interview', 37, 'المنصب الوظيفي')" /></td><td><t t-out="h.t('interview', 38, 'التوقيع')" /></td><td><t t-out="h.t('interview', 39, 'التاريخ')" /></td></tr>
                        <tr style="height:12mm;"><td /><td class="ad-b"><t t-out="h.t('interview', 40, 'مسؤول التوظيف')" /></td><td /><td /></tr>
                        <tr style="height:12mm;"><td /><td class="ad-b"><t t-out="h.t('interview', 41, 'م. مدير قسم العمليات')" /></td><td /><td /></tr>
                    </table>
                    <t t-set="title" t-value="'شعبة التدريب:'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <t t-set="tr" t-value="[('1- تدريب السلاح', doc.t_weapon), ('2- قانون استخدام القوة', doc.t_force_law), ('3- قانون النزاع المسلح', doc.t_armed_conflict), ('4- تفتيش الاشخاص والعجلات', doc.t_search)]" />
                    <table class="ad-t">
                        <tr><td colspan="3" class="ad-b ad-c"><t t-out="h.t('interview', 42, 'التقييم')" /></td></tr>
                        <t t-foreach="tr" t-as="q"><tr><td t-out="q[0]" /><td style="width:18%;"><t t-out="h.t('interview', 43, 'اجتياز')" /> <span t-out="h.box(q[1] == 'pass')" /></td><td style="width:18%;"><t t-out="h.t('interview', 44, 'اخفاق')" /> <span t-out="h.box(q[1] == 'fail')" /></td></tr></t>
                    </table>
                </div>

                
                <t t-set="pg" t-value="3" />
                <div class="ad-page" style="font-size:9pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <div class="ad-b" style="margin-top:4mm;"><t t-out="h.t('interview', 45, 'إذا اخترت انسحاب المرشح / عدم تعيين المرشح، فحدد سبب التوصية أدناه:')" /></div>
                    <table class="ad-t" style="margin-top:2mm; line-height:1.9;">
                        <tr class="ad-b ad-c"><td><t t-out="h.t('interview', 46, 'انسحاب المرشح')" /></td><td><t t-out="h.t('interview', 47, 'عدم تعيين المرشح')" /></td></tr>
                        <tr>
                            <td style="vertical-align:top;">
                                <div><span t-out="h.box(doc.w_salary)" /> <t t-out="h.t('interview', 48, 'الراتب منخفض جدا')" /></div>
                                <div><span t-out="h.box(doc.w_duties)" /> <t t-out="h.t('interview', 49, 'الواجبات الوظيفية')" /></div>
                                <div><span t-out="h.box(doc.w_hours)" /> <t t-out="h.t('interview', 50, 'ساعات العمل / جدول العمل')" /></div>
                                <div><span t-out="h.box(doc.w_other_job)" /> <t t-out="h.t('interview', 51, 'وظيفة أخرى')" /></div>
                                <div><span t-out="h.box(doc.w_mind)" /> <t t-out="h.t('interview', 52, 'تغير الرأي')" /></div>
                                <div><span t-out="h.box(doc.w_other)" /> <t t-out="h.t('interview', 53, 'سبب آخر:')" /> <span t-out="doc.w_other" /></div>
                            </td>
                            <td style="vertical-align:top;">
                                <div><span t-out="h.box(doc.r_qualif)" /> <t t-out="h.t('interview', 54, 'تقييم المؤهلات والجدارات دون المتطلبات او غير مستوفي')" /></div>
                                <div><span t-out="h.box(doc.r_health)" /> <t t-out="h.t('interview', 55, 'اخفاق في التقييم الصحي')" /></div>
                                <div><span t-out="h.box(doc.r_security)" /> <t t-out="h.t('interview', 56, 'اخفاق في التقييم الامني')" /></div>
                                <div><span t-out="h.box(doc.r_training)" /> <t t-out="h.t('interview', 57, 'عدم اجتياز التدريب الأمني بنجاح')" /></div>
                                <div><span t-out="h.box(doc.r_other)" /> <t t-out="h.t('interview', 58, 'سبب آخر:')" /> <span t-out="doc.r_other" /></div>
                            </td>
                        </tr>
                    </table>
                    <t t-set="title" t-value="'التوصية النهائية:'" /><t t-call="abnaa_dijlah_hr.ad_interview_bar" />
                    <table class="ad-t ad-c">
                        <tr><td><span t-out="h.box(doc.recommendation == 'withdraw')" /> <t t-out="h.t('interview', 59, 'انسحاب المرشح')" /></td><td><span t-out="h.box(doc.recommendation == 'reject')" /> <t t-out="h.t('interview', 60, 'عدم تعيين المرشح')" /></td><td><span t-out="h.box(doc.recommendation == 'hire')" /> <t t-out="h.t('interview', 61, 'تعيين المرشح')" /></td></tr>
                    </table>
                    <div class="ad-grey ad-c ad-b" style="margin-top:4mm; padding:1mm; font-size:10pt;"><t t-out="h.t('interview', 62, 'Statement of Ethics')" /><br /><t t-out="h.t('interview', 63, 'بيان الاخلاقيات والاقرار بالعلم لمدونة السلوك المهني')" /></div>
                    <div style="font-size:9.5pt; line-height:1.7; margin-top:3mm;">
                        <t t-out="h.t('interview', 64, 'تلتزم شركة ابناء دجلة بإطار التوظيف والاختيار والتعيين الذي يتيح تحديد وجذب واختيار الشخص الأكثر ملاءمة للمنصب. يتيح هذا الاجراء تعيين الموظفين الذين يمثلون اهداف الشركة بالإضافة إلى المهارات والقدرات لتحقيق الأهداف الاستراتيجية لشركة، ومن الضروري ان نضع انفسنا في اعلى مستوى، من الاخلاقيات وتنفيذ الإجراءات.')" />
                        <br /><t t-out="h.t('interview', 65, 'ومن اجل المحافظة على سمعة الشركة من الواجب ان يلتزم موظفيها بالنواحي الأخلاقية والنزاهة، ويخضع كل موظفي الشركة الى المراجعة الدائمة لغرض عدم الانحراف عن قواعد السلوك العامة ويتعين على جميع افراد الشركة الالتزام والتقيد بها:')" />
                        <div class="ad-b ad-u" style="margin-top:2mm;"><t t-out="h.t('interview', 66, 'المدونـــــــــــة:')" /></div>
                        <ol style="padding-right:7mm; margin:0;">
                            <li><t t-out="h.t('interview', 67, 'لا يجوز استخدام اسم او هوية الشركة في قضايا خارجة عن أنشطة الشركة ودون علمها، ولن يتم التغاضي عن دفع المال الغير الأخلاقي او توزيع الاعمال بشكل غير نزيه او المشاركة في اعمال غير مشروعة مثل الرشوة او غسيل الأموال.')" /></li>
                            <li><t t-out="h.t('interview', 68, 'يجب تأدية الواجبات بضمير حي وبشكل يحقق اقصى فائدة للشركة وعملائها.')" /></li>
                            <li><t t-out="h.t('interview', 69, 'لا يحق لأي شخص الحصول على امتياز شخصي بحكم موقعه في الشركة، ولا تقبل أي هدايا او مجاملات او خدمات دون مقابل من أي جهة كانت لأغراض تتعلق بعمل الشركة سواء تم تقديمها بحسن نية ام لا.')" /></li>
                            <li><t t-out="h.t('interview', 70, 'لا يحق لك تهديد او الاعتراض او النشر او المطالبة بتطبيق العادات العشائرية في حالة حصول النزاع بينك وبين الشركة او النشر في الاعلام او الامتناع عن تطبيق اعمال الشركة وتنفيذ العمل وفق القانون وعدم تهديد زملائك ومسؤولي العمل في حالة معاقبتك عن عملاً قمت به وكنت السبب في ذلك.')" /></li>
                            <li><t t-out="h.t('interview', 71, 'تستخدم أموال الشركة واملاكها لأغراض اعمال الشركة المشروعة، وسوف يتم تطبيق ضوابط داخلية صارمة وإجراءات لمنع الاحتيال ولحماية أملاك الشركة.')" /></li>
                            <li><t t-out="h.t('interview', 72, 'المعلومات التي يتم الحصول عليها اثناء المعاملات التجارية للشركة يجب حمايتها واحترام خصوصيتها.')" /></li>
