<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_transfer" model="ir.actions.report">
        <field name="name">استمارة تنقلات الحراس لمواقع العمل (AD-HR-FM-09)</field>
        <field name="model">ad.transfer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_transfer</field>
        <field name="print_report_name">'Guard transfer - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_transfer" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_ad_transfer">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="pg" t-value="1" /><t t-set="pgs" t-value="2" />
                <div class="ad-page" style="font-size:9.5pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <t t-set="seq" t-value="doc.name if doc.name != '/' else ''" />
                    <t t-set="dt" t-value="doc.date" />
                    <t t-set="rounded" t-value="False" />
                    <t t-call="abnaa_dijlah_hr.ad_form_seqrow" />
                    <t t-set="shift_am" t-value="doc.start_shift == 'am'" />

                    
                    <table class="ad-t" style="margin-top:2mm;"><tr>
                        <td style="width:8mm;" class="ad-c ad-b">1</td>
                        <td class="ad-b" style="padding:1.5mm 3mm;"><t t-out="h.t('transfer', 1, 'اسم الموظف :')" /> <span t-out="doc.employee_id.name" /></td>
                    </tr></table>
                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:8mm; writing-mode:vertical-rl;" class="ad-c ad-b"><t t-out="h.t('transfer', 2, 'قسم العمليات')" /></td>
                        <td class="ad-b" style="padding:2mm 3mm; line-height:2;">
                            <t t-out="h.t('transfer', 3, 'موقع العمل الحالي :')" /> <span t-out="doc.old_site_id.name" /><br />
                            <t t-out="h.t('transfer', 4, 'رقم الموظــــــف :')" /> <span class="ad-d" t-out="doc.employee_no" /><br />
                            <t t-out="h.t('transfer', 5, 'اسم المشرف الحالي :')" /> <span t-out="doc.old_supervisor" />   <t t-out="h.t('transfer', 6, 'رقم الموبايل :')" /> <span class="ad-d" t-out="doc.old_supervisor_mobile" />
                            <table class="ad-nb" style="margin-top:2mm;"><tr>
                                <td><t t-out="h.t('transfer', 7, 'مدير قسم العمليات')" /></td><td><t t-out="h.t('transfer', 8, 'التوقيع')" /></td><td><t t-out="h.t('transfer', 9, 'التاريخ :')" /> <span class="ad-d">202   /   /</span></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:8mm;" class="ad-c ad-b">2</td>
                        <td style="padding:1.5mm 3mm; line-height:1.9;" class="ad-b">
                            <t t-out="h.t('transfer', 10, 'الى السيد مشرف الموقع :')" /> <span t-out="doc.new_site_id.name" /><br />
                            <t t-out="h.t('transfer', 11, 'نأمل اعتماد مباشرة العمل للموظف المذكور في موقع العمل:')" /><br />
                            <t t-out="h.t('transfer', 12, 'الذي باشر بتاريخ :')" /> <span class="ad-d" t-out="h.d3(doc.start_date)" /> ( <span t-out="'ق.ظ' if doc.start_shift == 'am' else 'ب.ظ'" /> )
                            <table class="ad-nb" style="margin-top:1mm;">
                                <tr><td><t t-out="h.t('transfer', 13, 'مدير قسم العمليات')" /></td><td><t t-out="h.t('transfer', 14, 'التوقيع')" /></td><td><t t-out="h.t('transfer', 15, 'التاريخ :')" /> <span class="ad-d">202   /   /</span></td></tr>
                                <tr><td><t t-out="h.t('transfer', 16, 'اسم المشرف الحالي :')" /></td><td><t t-out="h.t('transfer', 17, 'التوقيع')" /></td><td><t t-out="h.t('transfer', 18, 'التاريخ :')" /> <span class="ad-d">202   /   /</span></td></tr>
                                <tr><td><t t-out="h.t('transfer', 19, 'اسم المشرف المستلم :')" /></td><td><t t-out="h.t('transfer', 20, 'التوقيع')" /></td><td><t t-out="h.t('transfer', 21, 'التاريخ :')" /> <span class="ad-d">202   /   /</span></td></tr>
                            </table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:8mm;" class="ad-c ad-b">3</td>
                        <td style="padding:1.5mm 3mm; line-height:1.9;" class="ad-b">
                            <t t-out="h.t('transfer', 22, 'الى / قسم الموارد البشرية')" /><br />
                            <t t-out="h.t('transfer', 23, 'تم اعتماد مباشرة العمل المذكور في موقع العمل :')" /> <span t-out="doc.new_site_id.name" /><br />
                            <t t-out="h.t('transfer', 24, 'بدلا من موقع العمل :')" /> <span t-out="doc.old_site_id.name" />   <t t-out="h.t('transfer', 25, 'بتاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.leave_date or doc.start_date)" />
                            ( <span t-out="'ق.ظ' if doc.leave_shift == 'am' else 'ب.ظ'" /> )
                            <table class="ad-nb" style="margin-top:1mm;"><tr>
                                <td><t t-out="h.t('transfer', 26, 'مشرف الموقع')" /></td><td><t t-out="h.t('transfer', 27, 'مدير قسم العمليات')" /></td><td><t t-out="h.t('transfer', 28, 'التاريخ :')" /> <span class="ad-d">202   /   /</span></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:8mm; writing-mode:vertical-rl;" class="ad-c ad-b"><t t-out="h.t('transfer', 29, 'المدير المفوض')" /></td>
                        <td style="padding:2mm 3mm; line-height:1.8;" class="ad-b">
                            <t t-out="h.t('transfer', 30, 'نود لكم بان الموظف المذكور هو احد منتسبي شركة ابناء دجلة لخدمات الامن والحماية المحدودة والتي تحمل رخصة رمز (')" /> <span t-out="doc.company_id.ad_license_code" /> <t t-out="h.t('transfer', 31, ') ويعتبر هذا الامر بمثابة تخويل للموظف لممارسة عمله لدى الشركة في الموقع المذكور ونافذا لغاية شهر واحد من تاريخ إصداره.')" />
                            <div style="margin-top:3mm; line-height:1.9;">
                                <t t-out="h.t('transfer', 32, 'المدير المفوض')" /><br /><t t-out="h.t('transfer', 33, 'الاسم :')" /> <span t-out="doc.company_id.ad_md_name" /><br /><t t-out="h.t('transfer', 34, 'التوقيع :')" /><br />
                                <t t-out="h.t('transfer', 35, 'التاريخ :')" /> <span class="ad-d">202   /   /</span>
                            </div>
                        </td>
                    </tr></table>
                    <div class="ad-copy" style="margin-top:3mm;">
                        <u><t t-out="h.t('transfer', 36, 'نسخة منه الى:')" /></u><br />
                        <t t-out="h.t('transfer', 37, '- القسم المالي / للتفضل بالاطلاع واتخاذ ما يلزم.. مع التقدير')" /><br />
                        <t t-out="h.t('transfer', 38, '- قسم الموارد البشرية/ للحفظ واتخاذ ما يلزم.. مع التقدير')" />
                    </div>
                </div>

                <t t-set="pg" t-value="2" />
                <div class="ad-page">
                    <div style="border:0.8mm double #000; height:262mm;" />
                </div>
            </t>
        </t>
    </template>
</odoo>