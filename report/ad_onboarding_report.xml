<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_onboarding" model="ir.actions.report">
        <field name="name">استمارة تاريخ مباشرة العمل (AD-WI-FM-06-03)</field>
        <field name="model">ad.onboarding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_onboarding</field>
        <field name="print_report_name">'Effective date notice - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_onboarding" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_ad_onboarding">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="pg" t-value="1" /><t t-set="pgs" t-value="1" />
                <div class="ad-page" style="font-size:9.5pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <t t-set="seq" t-value="doc.name if doc.name != '/' else ''" />
                    <t t-set="dt" t-value="doc.date" />
                    <t t-set="rounded" t-value="False" />
                    <t t-call="abnaa_dijlah_hr.ad_form_seqrow" />

                    
                    <table class="ad-t" style="margin-top:2mm;"><tr>
                        <td style="width:7mm;" class="ad-grey ad-c ad-b">1</td>
                        <td style="padding:1.2mm 3mm; line-height:1.5;">
                            <div class="ad-b"><t t-out="h.t('onboarding', 1, 'اسم الموظف:')" /> <span t-out="doc.employee_id.name" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 2, 'موقع العمـــل:')" /> <span t-out="doc.site_id.name" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 3, 'تاريخ المباشرة:')" /> <span class="ad-d" t-out="h.d3(doc.start_date)" /> ( <span t-out="'ق.ظ' if doc.start_shift == 'am' else 'ب.ظ'" /> )</div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 4, 'رقم امر التعيين:')" /> <span t-out="doc.appointment_id.name" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 5, 'اسم المشــــرف:')" /> <span t-out="doc.supervisor_name" />    <t t-out="h.t('onboarding', 6, 'رقم الموبايل:')" /> <span class="ad-d" t-out="doc.supervisor_mobile" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 7, 'تم تسليم الموظف:')" /></div>
                            <div>  <span t-out="h.box(doc.medical_done)" /> <t t-out="h.t('onboarding', 8, 'فحص طبي \xa0 رقم الكتاب (')" /> <span t-out="doc.medical_letter" /> )</div>
                            <div>  <span t-out="h.box(doc.salary_done)" /> <t t-out="h.t('onboarding', 9, 'توطين راتب \xa0 رقم الكتاب (')" /> <span t-out="doc.salary_letter" /> )</div>
                            <div>  <span t-out="h.box(doc.auth_done)" /> <t t-out="h.t('onboarding', 10, 'كتاب تخويل \xa0 رقم الكتاب (')" /> <span t-out="doc.auth_letter" /> )</div>
                            <table class="ad-nb ad-b" style="margin-top:2mm;"><tr>
                                <td><t t-out="h.t('onboarding', 11, 'الموظف المختص')" /><br /><t t-out="h.t('onboarding', 12, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 13, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                                <td><t t-out="h.t('onboarding', 14, 'مدير قسم الموارد البشرية')" /><br /><t t-out="h.t('onboarding', 15, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 16, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:7mm;" class="ad-grey ad-c ad-b">2</td>
                        <td style="padding:1.2mm 3mm; line-height:1.5;">
                            <div class="ad-b"><t t-out="h.t('onboarding', 17, 'تم تجهيز الموظف بالمواد التالية بتاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.issue_date)" /></div>
                            <div><span t-out="h.box(doc.shirt_size)" /> <t t-out="h.t('onboarding', 18, 'قميص قياس (')" /> <span t-out="doc.shirt_size" /> )    <span t-out="h.box(doc.trouser_size)" /> <t t-out="h.t('onboarding', 19, 'بنطرون قياس (')" /> <span t-out="doc.trouser_size" /> )</div>
                            <div><span t-out="h.box(doc.shoe_size)" /> <t t-out="h.t('onboarding', 20, 'حذاء قياس (')" /> <span t-out="doc.shoe_size" /> )    <span t-out="h.box(doc.has_pouch)" /> <t t-out="h.t('onboarding', 21, 'جعبة')" />    <span t-out="h.box(doc.other_items)" /> <t t-out="h.t('onboarding', 22, 'أخرى تذكر (')" /> <span t-out="doc.other_items" /> )</div>
                            <table class="ad-nb ad-b"><tr>
                                <td><t t-out="h.t('onboarding', 23, 'الموظف المختص')" /><br /><t t-out="h.t('onboarding', 24, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 25, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                                <td><t t-out="h.t('onboarding', 26, 'مشرف الموقع')" /><br /><t t-out="h.t('onboarding', 27, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 28, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:7mm;" class="ad-grey ad-c ad-b">3</td>
                        <td style="padding:1.2mm 3mm; line-height:1.5;">
                            <div class="ad-b"><t t-out="h.t('onboarding', 29, 'الى السيد مدير قسم العمليات المحترم: نأمل اعتماد مباشرة العمل للموظف:')" /> <span t-out="doc.employee_id.name" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 30, 'الذي باشر في الموقع بتاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.start_date)" /> ( <span t-out="'ق.ظ' if doc.start_shift == 'am' else 'ب.ظ'" /> )</div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 31, 'نؤيد استلام ما يلي:')" />
                                 <span t-out="h.box(doc.ops_medical)" /> <t t-out="h.t('onboarding', 32, 'فحص طبي')" />
                                 <span t-out="h.box(doc.ops_salary)" /> <t t-out="h.t('onboarding', 33, 'توطين')" />
                                 <span t-out="h.box(doc.ops_auth)" /> <t t-out="h.t('onboarding', 34, 'تخويل')" /></div>
                            <table class="ad-nb ad-b"><tr>
                                <td><t t-out="h.t('onboarding', 35, 'مشرف الموقع')" /><br /><t t-out="h.t('onboarding', 36, 'الاسم:')" /> <span t-out="doc.supervisor_name" /><br /><t t-out="h.t('onboarding', 37, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 38, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:7mm;" class="ad-grey ad-c ad-b">4</td>
                        <td style="padding:1.2mm 3mm; line-height:1.5;">
                            <div class="ad-b"><t t-out="h.t('onboarding', 39, 'الى / قسم الموارد البشرية: نأمل اعتماد مباشرة العمل للموظف:')" /> <span t-out="doc.employee_id.name" /></div>
                            <div class="ad-b"><t t-out="h.t('onboarding', 40, 'بتاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.start_date)" /> ( <span t-out="'ق.ظ' if doc.start_shift == 'am' else 'ب.ظ'" /> )</div>
                            <div class="ad-b"><span t-out="h.box(doc.training_done)" /> <t t-out="h.t('onboarding', 41, 'تم استيفاء التدريب اللازم.')" /></div>
                            <table class="ad-nb ad-b"><tr>
                                <td><t t-out="h.t('onboarding', 42, 'مدير قسم العمليات')" /><br /><t t-out="h.t('onboarding', 43, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 44, 'التاريخ:')" /> <span class="ad-d">202   /   /</span></td>
                                <td><t t-out="h.t('onboarding', 45, 'توقيع المدرب')" /><br /><span t-out="doc.trainer_name" /></td>
                            </tr></table>
                        </td>
                    </tr></table>

                    
                    <table class="ad-t" style="margin-top:-1px;"><tr>
                        <td style="width:7mm;" class="ad-grey ad-c ad-b">5</td>
                        <td style="padding:1.2mm 3mm; line-height:1.5;" class="ad-b">
                            <t t-out="h.t('onboarding', 46, 'المدير المفوض')" /><br /><t t-out="h.t('onboarding', 47, 'الاسم:')" /> <span t-out="doc.company_id.ad_md_name" /><br /><t t-out="h.t('onboarding', 48, 'التوقيع: ................')" /><br /><t t-out="h.t('onboarding', 49, 'التاريخ:')" /> <span class="ad-d">202   /   /</span>
                        </td>
                    </tr></table>

                    <div class="ad-copy" style="margin-top:4mm;">
                        <u><t t-out="h.t('onboarding', 50, 'نسخة منه الى:')" /></u><br />
                        <t t-out="h.t('onboarding', 51, '- القسم المالي / للتفضل بالاطلاع واتخاذ ما يلزم.. مع التقدير')" /><br />
                        <t t-out="h.t('onboarding', 52, '- قسم الموارد البشرية/ للحفظ واتخاذ ما يلزم.. مع التقدير')" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>