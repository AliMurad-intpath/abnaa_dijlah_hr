<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_clearance" model="ir.actions.report">
        <field name="name">استمارة براءة الذمة (AD-WI-FM-06-11)</field>
        <field name="model">ad.clearance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_clearance</field>
        <field name="print_report_name">'Clearance - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_clearance" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_ad_clearance">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="depts" t-value="[('ops', 'قسم العمليات - OPS  +  المشجب'), ('aa', 'قسم الإدارة- AA'), ('lo', 'قسم اللوجيستسك- LO'), ('md', 'قسم الاليات- MD'), ('hr', 'قسم الموارد البشرية- HR'), ('fin', 'قسم المالية-FIN')]" />
                <t t-set="reasons" t-value="[('martyr', 'لاستشهاده'), ('death', 'لوفاته'), ('resignation', 'لاستقالته'), ('termination', 'انهاء خدماته'), ('investigation', 'مجلس تحقيقي')]" />

                
                <t t-set="pg" t-value="1" /><t t-set="pgs" t-value="2" />
                <div class="ad-page">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <table class="ad-t" style="margin-top:2mm; font-size:9.5pt; font-weight:bold;">
                        <tr>
                            <td style="width:50%;"><t t-out="h.t('clearance', 1, 'اسم الموظف :')" /> <span t-out="doc.employee_id.name" /></td>
                            <td style="width:50%;"><t t-out="h.t('clearance', 2, 'عنوان السكن:')" /> <span t-out="doc.address" /></td>
                        </tr>
                        <tr>
                            <td><t t-out="h.t('clearance', 3, 'عنوان وظيفته:')" /> <span t-out="doc.job_title" /></td>
                            <td><t t-out="h.t('clearance', 4, 'تاريخ التعيين:')" /> <span class="ad-d" t-out="h.d3(doc.hire_date)" /></td>
                        </tr>
                        <tr>
                            <td><t t-out="h.t('clearance', 5, 'محل العمل:')" /> <span t-out="doc.site_id.name" /></td>
                            <td><t t-out="h.t('clearance', 6, 'تاريخ التوقف عن العمل:')" /> <span class="ad-d" t-out="h.d3(doc.stop_date)" /></td>
                        </tr>
                        <tr>
                            <td colspan="2" class="ad-grey" style="font-size:8.5pt;">
                                <t t-out="h.t('clearance', 7, 'قطعت علاقته بالوظيفة / لاستشهاده / لوفاته')" />
                                <t t-foreach="reasons" t-as="r">
                                    <span t-out="r[1]" /> <span t-att-class="'ad-box on' if doc.reason == r[0] else 'ad-box'" />
                                </t>
                                <br /><t t-out="h.t('clearance', 8, 'بموجب الامر المرقم بالعدد (')" /> <span t-out="doc.order_no" /> <t t-out="h.t('clearance', 9, ') والمؤرخ في (')" /> <span class="ad-d" t-out="h.d3(doc.order_date)" /> )
                            </td>
                        </tr>
                    </table>
                    <table class="ad-t" style="font-size:9pt;">
                        <tr class="ad-grey ad-b ad-c">
                            <td style="width:24%;"><t t-out="h.t('clearance', 10, 'القسم')" /></td>
                            <td style="width:15%;"><t t-out="h.t('clearance', 11, 'اسم مدير القسم')" /></td>
                            <td style="width:13%;"><t t-out="h.t('clearance', 12, 'التوقيع')" /></td>
                            <td><t t-out="h.t('clearance', 13, 'الملاحظات في حالة وجود ذمة مالية او وظيفية تكتب بالتفصيل ويعكس يكتب ذمة غير مشغولة')" /></td>
                        </tr>
                        <t t-foreach="depts" t-as="d">
                            <t t-set="ln" t-value="doc.line_ids.filtered(lambda l: l.department == d[0])[:1]" />
                            <tr style="height:14mm;">
                                <td class="ad-b" t-out="d[1]" />
                                <td class="ad-c" t-out="ln.manager_name if ln else ''" />
                                <td />
                                <td class="ad-c ad-b">
                                    <t t-if="ln and ln.has_liability"><t t-out="h.t('clearance', 14, 'يوجد لديه مستحقات')" /></t>
                                    <t t-if="ln and ln.note"><div t-out="ln.note" /></t>
                                </td>
                            </tr>
                        </t>
                        <tr><td colspan="4" class="ad-c ad-b ad-ltr"><t t-out="h.t('clearance', 15, 'مخالصة وإبراء ذمة Emp. – AD . Clearance')" /></td></tr>
                    </table>
                    <table class="ad-t" style="border-top:none;">
                        <tr><td style="padding:2mm 3mm; font-size:9pt; line-height:1.5; border-bottom:none;">
                            <t t-out="h.t('clearance', 16, 'أنا الموقع في أدناه اقر باستلام كافة حقوقي ومستحقاتي (')" /> <span class="ad-fill" t-out="doc.employee_id.name" /> <t t-out="h.t('clearance', 17, ') عن فترة عملي في شركة ابناء دجلة لخدمات الامن والحماية المحدودة لغاية تاريخ توقفي عن العمل ولم يتبق لي في ذمتهم اية حقوق عملية المتطلبات من رواتب او مكافآت نهاية الخدمة او بدل عمل اضافي بدل دوام لايام العطل الاسبوعية و الدينية و الرسمية وغيرها.')" /><br />
                            <t t-out="h.t('clearance', 18, 'وإني بذلك لا أبرئ الشركة حاضــرا او مستقبلا من اية مطالبات تتعلق بالحقوق المذكورة في عقد العمل والمستحقة حسب قانون العمل العراقي وعليه وقعت.')" /><br />
                            <t t-out="h.t('clearance', 19, 'واقر باستلامي مبلغا وقدره (')" /> <span class="ad-fill" t-out="h.money(doc.amount_paid)" /> <t t-out="h.t('clearance', 20, ') دينار . $')" />
                        </td></tr>
                    </table>
                    <table class="ad-nb" style="font-size:9.5pt; font-weight:bold; margin-top:1mm;">
                        <tr>
                            <td style="width:72%; line-height:2.4;">
                                <t t-out="h.t('clearance', 21, 'الاســــم الثلاثي:')" /> <span t-out="doc.employee_id.name" /><br />
                                <t t-out="h.t('clearance', 22, 'رقم هوية الاحوال المدنية / البطاقة الوطنية:')" /> <span class="ad-d" t-out="doc.employee_id.identification_id or ''" /><br />
                                <t t-out="h.t('clearance', 23, 'التاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.receipt_date)" /><br />
                                <t t-out="h.t('clearance', 24, 'التوقيع:')" />
                            </td>
                            <td class="ad-c"><div class="ad-bd" style="height:22mm; padding-top:8mm;"><t t-out="h.t('clearance', 25, 'بصمة الابهام الايسر')" /></div></td>
                        </tr>
                    </table>
                    <table class="ad-nb ad-b" style="font-size:9.5pt; margin-top:6mm;">
                        <tr>
                            <td class="ad-c"><t t-out="h.t('clearance', 26, 'الشاهد الثاني')" /><div t-out="doc.witness2" /></td>
                            <td class="ad-c"><t t-out="h.t('clearance', 27, 'الشاهد الاول')" /><div t-out="doc.witness1" /></td>
                        </tr>
                    </table>
                    <div class="ad-c ad-b" style="margin-top:8mm;">1</div>
                </div>

                
                <t t-set="pg" t-value="2" /><t t-set="pgs" t-value="2" />
                <div class="ad-page">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <table class="ad-t" style="margin-top:2mm; font-size:9.5pt;">
                        <tr><td style="height:7mm;" /></tr>
                        <tr><td class="ad-c ad-b"><t t-out="h.t('clearance', 28, 'مستحقات السيد (')" /> <span t-out="doc.employee_id.name" /> )</td></tr>
                        <t t-foreach="range(5)" t-as="i">
                            <t t-set="due" t-value="doc.due_ids[i] if i &lt; len(doc.due_ids) else False" />
                            <tr style="height:6mm;">
                                <td>
                                    <t t-if="due"><span t-out="due.name" /> : <span class="ad-d" t-out="h.money(due.amount)" /></t>
                                </td>
                            </tr>
                        </t>
                        <tr><td class="ad-b" style="text-decoration:underline;"><t t-out="h.t('clearance', 29, 'السيد المدير المفوض المحترم:')" /></td></tr>
                        <tr><td style="height:6mm;" /></tr>
                        <tr><td style="height:6mm;" t-out="doc.hr_note" /></tr>
                        <tr><td style="height:16mm;" /></tr>
                        <tr><td style="font-size:9.5pt; font-weight:bold; padding-top:3mm;">
                            <t t-out="h.t('clearance', 30, 'نود اعلامكم بان الموظف قد سلم جميع ما بعهدته ولا شي بذمته لشركتنا وتم تسليمه جميع مستحقاته .')" />
                            <table class="ad-nb ad-c" style="margin-top:10mm; font-size:9pt;">
                                <tr>
                                    <td><t t-out="h.t('clearance', 31, 'الموظف المختص')" /></td><td><t t-out="h.t('clearance', 32, 'مدير قسم الموارد البشرية')" /></td><td><t t-out="h.t('clearance', 33, 'مصادقة المدير المفوض')" /></td>
                                </tr>
                                <tr>
                                    <td class="ad-d">202    /    /</td>
                                    <td class="ad-d">202    /    /</td>
                                    <td class="ad-d">202    /    /</td>
                                </tr>
                            </table>
                            <div class="ad-c ad-b" style="margin-top:14mm;">2</div>
                        </td></tr>
                        <tr><td style="height:28mm;" /></tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>