<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="action_report_ad_discipline" model="ir.actions.report">
        <field name="name">استمارة العقوبات (AD-HR-FM-10)</field>
        <field name="model">ad.discipline</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">abnaa_dijlah_hr.report_ad_discipline</field>
        <field name="print_report_name">'Penalty form - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="abnaa_dijlah_hr.paperformat_ad_a4" />
        <field name="binding_model_id" ref="model_ad_discipline" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_ad_discipline">
        <t t-call="abnaa_dijlah_hr.ad_form_wrapper">
            <t t-set="h" t-value="docs.env['ad.report.helper']" />
            <t t-foreach="docs" t-as="doc">
                <t t-set="tpl" t-value="doc.ad_tpl()" />
                <t t-set="pg" t-value="1" /><t t-set="pgs" t-value="1" />
                <t t-set="vios" t-value="doc.env['ad.violation.type'].search([], order='number')" />
                <t t-set="chosen" t-value="doc.violation_ids.mapped('number')" />
                <div class="ad-page" style="font-size:9.5pt;">
                    <t t-call="abnaa_dijlah_hr.ad_form_head" />
                    <t t-set="seq" t-value="doc.name if doc.name != '/' else ''" />
                    <t t-set="dt" t-value="doc.date" />
                    <t t-set="rounded" t-value="True" />
                    <t t-call="abnaa_dijlah_hr.ad_form_seqrow" />
                    <div class="ad-b" style="font-size:10.5pt; line-height:2.2; margin-top:3mm;">
                        <t t-out="h.t('discipline', 1, 'اسم الموظـــــــف :')" /> <span t-out="doc.employee_id.name" />     <t t-out="h.t('discipline', 2, 'التاريـــــــخ :')" /> <span class="ad-d" t-out="h.d3(doc.date)" /><br />
                        <t t-out="h.t('discipline', 3, 'العنوان الوظيفي :')" /> <span t-out="doc.job_title" />     <t t-out="h.t('discipline', 4, 'الرقم الوظيفي :')" /> <span class="ad-d" t-out="doc.employee_no" />
                    </div>
                    <div class="ad-b" style="font-size:10.5pt; line-height:1.6; margin-top:2mm;">
                        <t t-out="h.t('discipline', 5, 'ان هذا التقرير سيعرض على اقسام الشركة وسيصبح جزء من سجلكم الشخصي وننبهكم وننذركم من ان الاستمرار في انتهاك قوانين العمل سيؤدي الى عدم التشجيع على ترقيتك او الاستغناء عن خدماتكم.')" />
                    </div>
                    <table class="ad-t" style="margin-top:4mm; font-size:9pt;">
                        <t t-foreach="range(0, 20, 2)" t-as="i">
                            <tr style="height:9mm;">
                                <t t-foreach="[i, i + 1]" t-as="j">
                                    <t t-set="v" t-value="vios[j] if j &lt; len(vios) else False" />
                                    <td style="width:6mm;" class="ad-c ad-b"><span t-out="str(j + 1) + '.'" /></td>
                                    <td t-att-class="'ad-grey ad-b' if (j + 1) in chosen else ''" style="width:44%;"><span t-if="v" t-out="v.name" /></td>
                                </t>
                            </tr>
                        </t>
                    </table>
                    <div class="ad-b" style="margin-top:4mm; font-size:10.5pt;">
                        <t t-out="h.t('discipline', 6, 'تكرار المخالفة : \xa0\xa0 الأولى')" /> <span t-out="h.box(doc.repetition == '1')" />
                           <t t-out="h.t('discipline', 7, 'الثانية')" /> <span t-out="h.box(doc.repetition == '2')" />
                           <t t-out="h.t('discipline', 8, 'الثالثة')" /> <span t-out="h.box(doc.repetition == '3')" />
                    </div>
                    <table class="ad-t" style="margin-top:3mm; font-size:9.5pt;">
                        <tr>
                            <td rowspan="3" class="ad-b" style="width:24%; line-height:2.2;">
                                <t t-out="h.t('discipline', 9, 'القرار:')" /><br />
                                <t t-out="h.t('discipline', 10, 'إيقاف عن العمل:')" /> <span t-out="h.box(doc.decision == 'suspension')" /><br />
                                <t t-out="h.t('discipline', 11, 'عقوبة خصم الراتب:')" /> <span t-out="h.box(doc.decision == 'deduction')" /><br />
                                <t t-out="h.t('discipline', 12, 'عقوبة انهاء الخدمات:')" /> <span t-out="h.box(doc.decision == 'termination')" />
                            </td>
                            <td class="ad-b"><t t-out="h.t('discipline', 13, 'من تاريخ:')" /> <span class="ad-d" t-out="h.d3(doc.date_from)" /></td>
                            <td class="ad-b"><t t-out="h.t('discipline', 14, 'الى تاريخ :')" /> <span class="ad-d" t-out="h.d3(doc.date_to)" /></td>
                            <td class="ad-b"><t t-out="h.t('discipline', 15, 'مجموع الأيام')" /> <span t-out="doc.total_days or ''" /></td>
                        </tr>
                        <tr>
                            <td class="ad-b"><t t-out="h.t('discipline', 16, 'نوع الخصم :')" /> <span t-out="doc.deduction_type" /></td>
                            <td class="ad-b" colspan="2"><t t-out="h.t('discipline', 17, 'مبلغ الخصم')" /> <span t-out="h.money(doc.deduction_amount) if doc.deduction_amount else ''" /></td>
                        </tr>
                        <tr>
                            <td class="ad-b" colspan="3"><t t-out="h.t('discipline', 18, 'من تأريخ :')" /> <span class="ad-d" t-out="h.d3(doc.deduction_from or doc.termination_from)" /></td>
                        </tr>
                    </table>
                    <div class="ad-b" style="font-size:10.5pt; line-height:2.4; margin-top:8mm;">
                        <t t-out="h.t('discipline', 19, 'توقيع مقدم العقوبة :...............................')" /><br />
                        <t t-out="h.t('discipline', 20, 'توقيع قسم الموارد البشرية :........................')" /><br />
                        <t t-out="h.t('discipline', 21, 'توقيع مدير قسم العمليات :.........................')" /><br />
                        <t t-out="h.t('discipline', 22, 'المدير المفوض :...................................')" />
                    </div>
                    <div class="ad-b" style="font-size:10.5pt; line-height:2.4; margin-top:2mm;">
                        <t t-out="h.t('discipline', 23, 'إقرار بالاستلام')" /><br />
                        <t t-out="h.t('discipline', 24, 'اسم الموظف :')" /> <span t-out="doc.employee_id.name" /><br />
                        <t t-out="h.t('discipline', 25, 'التوقيع :')" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>