<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_employee_pledge_view_list" model="ir.ui.view">
        <field name="name">ad.employee.pledge.list</field>
        <field name="model">ad.employee.pledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="guarantor_name"/>
                <field name="date"/>
                <field name="ad_status" widget="badge" decoration-info="ad_status == 'pending'" decoration-success="ad_status == 'approved'" decoration-danger="ad_status == 'rejected'" decoration-muted="ad_status in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="ad_employee_pledge_view_form" model="ir.ui.view">
        <field name="name">ad.employee.pledge.form</field>
        <field name="model">ad.employee.pledge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_signed" type="object" string="Signed mark" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ad_print" type="object" string="Preview PDF" invisible="ad_status == 'approved'"/>
                    <button name="action_ad_print" type="object" string="Print Signed PDF" class="btn-primary" invisible="ad_status != 'approved'"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="state == 'draft'"/>
                    <field name="state" invisible="1"/>
                    <field name="ad_status" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="employee_phone"/>
                            <field name="employee_address"/>
                        </group>
                        <group string="Guarantor">
                            <field name="guarantor_name"/>
                            <field name="guarantor_phone"/>
                            <field name="guarantor_address"/>
                            <field name="guarantor_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_employee_pledge_action" model="ir.actions.act_window">
        <field name="name">Written pledges (FM-17)</field>
        <field name="res_model">ad.employee.pledge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
