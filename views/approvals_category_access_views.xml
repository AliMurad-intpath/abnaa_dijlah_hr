<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ad_approval_category_access_list" model="ir.ui.view">
        <field name="name">ad.approval.category.access.list</field>
        <field name="model">approval.category</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="ad_user_ids" widget="many2many_tags"/>
                <field name="ad_group_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="ad_approval_category_access_action" model="ir.actions.act_window">
        <field name="name">صلاحيات انواع الموافقات</field>
        <field name="res_model">approval.category</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="ad_approval_category_access_list"/>
    </record>
    <menuitem id="menu_ad_approval_category_access" name="صلاحيات انواع الموافقات" parent="menu_ad_hr_config"
              sequence="35" action="ad_approval_category_access_action"/>
</odoo>
