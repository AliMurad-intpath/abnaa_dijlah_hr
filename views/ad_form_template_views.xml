<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_form_template_view_list" model="ir.ui.view">
        <field name="name">ad.form.template.list</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="title_ar"/>
                <field name="page_count"/>
                <field name="res_model" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ad_form_template_view_form" model="ir.ui.view">
        <field name="name">ad.form.template.form</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_designer" type="object" string="فتح مصمم الاستمارة" class="btn-primary"
                            invisible="not template_attachment_id"/>
                    <button name="action_download_pdf" type="object" string="تنزيل الـ PDF الفارغ"
                            invisible="not template_attachment_id"/>
                    <button name="action_clear_pdf" type="object" string="حذف الملف لرفع ملف جديد"
                            invisible="not template_attachment_id"
                            confirm="سيحذف الملف الحالي. الحقول والمراحل تبقى كما هي. متابعة؟"/>
                </header>
                <sheet>
                    <group>
                        <group string="الوثيقة">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="title_ar"/>
                            <field name="title_en"/>
                            <field name="res_model"/>
                            <field name="active"/>
                        </group>
                        <group string="ملف الـ PDF">
                            <field name="template_pdf" filename="template_filename" invisible="template_attachment_id"/>
                            <field name="template_filename"/>
                            <field name="page_count"/>
                            <field name="template_attachment_id" invisible="1"/>
                            <div class="text-muted" colspan="2">
                                ملف PDF الفارغ للاستمارة (كما تطبع على الورق). تطبع البيانات فوقه في الصناديق التي تحددها في المصمم.
                                لتبديل الملف اضغط (حذف الملف لرفع ملف جديد) ثم ارفع الجديد واحفظ.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="مراحل الموافقة" name="stages">
                            <p class="text-muted">
                                تمر الاستمارة بالمراحل بالترتيب. حدد مستخدما بعينه، او اتركه فارغا ليوافق اي عضو من المجموعة.
                            </p>
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key" optional="hide"/>
                                    <field name="approver_id"/>
                                    <field name="group_id"/>
                                    <field name="print_signature"/>
                                    <field name="signature_page" optional="hide"/>
                                    <button name="action_place_on_pdf" type="object" string="موضع التوقيع" icon="fa-arrows"/>
                                </list>
                            </field>
                        </page>
                        <page string="الحقول المطبوعة" name="fields">
                            <field name="field_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="source_path"/>
                                    <field name="match_value" optional="hide"/>
                                    <field name="page"/>
                                    <field name="font_size" optional="hide"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="key"/>
                                            <field name="field_type"/>
                                            <field name="source_path" invisible="field_type == 'system'"/>
                                            <field name="match_value" invisible="field_type not in ('mark', 'mark_in')"/>
                                            <field name="system_source" invisible="field_type != 'system'"/>
                                            <field name="stage_id" invisible="system_source not in ('approver_name', 'approval_date')"/>
                                            <field name="date_format" invisible="field_type not in ('date', 'system')"/>
                                        </group>
                                        <group>
                                            <field name="page"/>
                                            <field name="x"/>
                                            <field name="y"/>
                                            <field name="width"/>
                                            <field name="height"/>
                                            <field name="font_size"/>
                                            <field name="min_font_size"/>
                                            <field name="bold"/>
                                            <field name="multiline"/>
                                            <field name="text_align"/>
                                            <field name="font_family"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="ترويسة الوثيقة" name="header">
                            <group>
                                <field name="issue"/>
                                <field name="issue_date"/>
                                <field name="rev_date"/>
                                <field name="title_layout"/>
                                <field name="logo" widget="image" options="{'size': [0, 90]}"/>
                            </group>
                            <p class="text-muted">هذه القيم مطبوعة اصلا داخل ملف الـ PDF. تغييرها لا يغير الملف؛ ارفع PDF جديدا لتغيير الترويسة.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ad_form_template_action" model="ir.actions.act_window">
        <field name="name">قوالب الاستمارات (PDF والموافقات)</field>
        <field name="res_model">ad.form.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
