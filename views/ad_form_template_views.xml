<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_form_template_view_list" model="ir.ui.view">
        <field name="name">ad.form.template.list</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="title_ar"/>
                <field name="page_count"/>
                <field name="res_model" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ad_form_template_view_form" model="ir.ui.view">
        <field name="name">ad.form.template.form</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_designer" type="object" string="Open form designer" class="btn-primary"
                            invisible="not template_attachment_id"/>
                    <button name="action_download_pdf" type="object" string="Download blank PDF"
                            invisible="not template_attachment_id"/>
                    <button name="action_clear_pdf" type="object" string="Delete file to upload a new one"
                            invisible="not template_attachment_id"
                            confirm="The current file will be deleted. Fields and stages stay as they are. Continue?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Document">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="title_ar"/>
                            <field name="title_en"/>
                            <field name="res_model"/>
                            <field name="active"/>
                        </group>
                        <group string="PDF file">
                            <field name="template_pdf" filename="template_filename" invisible="template_attachment_id"/>
                            <field name="template_filename"/>
                            <field name="page_count"/>
                            <field name="template_attachment_id" invisible="1"/>
                            <div class="text-muted" colspan="2">
                                The blank PDF of the form (as printed on paper). Data is printed over it in the boxes you define in the designer.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval stages" name="stages">
                            <p class="text-muted">
                                The form goes through the stages in order. Select a specific user, or leave empty to let any member of the group approve.
                            </p>
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key" optional="hide"/>
                                    <field name="approver_id" string="Approver (user)" placeholder="Any member of the group"/>
                                    <field name="group_id" string="Or any member of the group" placeholder="Not needed when a user is set"/>
                                    <field name="approver_label" string="Who approves"/>
                                    <field name="deadline_hours"/>
                                    <field name="print_signature" string="Print signature"/>
                                    <field name="signature_page" optional="hide"/>
                                    <button name="action_place_on_pdf" type="object" string="Place on PDF" class="btn btn-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Printed fields" name="fields">
                            <field name="field_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="field_type"/>
                                    <field name="source_path"/>
                                    <field name="match_value" optional="hide"/>
                                    <field name="page"/>
                                    <field name="font_size" optional="hide"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="key"/>
                                            <field name="field_type"/>
                                            <field name="source_path" invisible="field_type == 'system'"/>
                                            <field name="match_value" invisible="field_type not in ('mark', 'mark_in')"/>
                                            <field name="system_source" invisible="field_type != 'system'"/>
                                            <field name="stage_id" invisible="system_source not in ('approver_name', 'approval_date')"/>
                                            <field name="date_format" invisible="field_type not in ('date', 'system')"/>
                                        </group>
                                        <group>
                                            <field name="page"/>
                                            <field name="x"/>
                                            <field name="y"/>
                                            <field name="width"/>
                                            <field name="height"/>
                                            <field name="font_size"/>
                                            <field name="min_font_size"/>
                                            <field name="bold"/>
                                            <field name="multiline"/>
                                            <field name="text_align"/>
                                            <field name="font_family"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Document header" name="header">
                            <group>
                                <field name="issue"/>
                                <field name="issue_date"/>
                                <field name="rev_date"/>
                                <field name="title_layout"/>
                                <field name="logo" widget="image" options="{'size': [0, 90]}"/>
                            </group>
                            <p class="text-muted">These values are already printed inside the PDF file. Changing them does not change the file; upload a new PDF to change the header.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ad_form_template_action" model="ir.actions.act_window">
        <field name="name">Form templates (PDF and approvals)</field>
        <field name="res_model">ad.form.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
