<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_form_template_view_list" model="ir.ui.view">
        <field name="name">ad.form.template.list</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="issue"/>
                <field name="issue_date"/>
                <field name="rev_date"/>
                <field name="title_ar"/>
            </list>
        </field>
    </record>
    <record id="ad_form_template_view_form" model="ir.ui.view">
        <field name="name">ad.form.template.form</field>
        <field name="model">ad.form.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="ضبط الوثيقة (يطبع في ترويسة الاستمارة)">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="issue"/>
                            <field name="issue_date"/>
                            <field name="rev_date"/>
                        </group>
                        <group>
                            <field name="title_ar"/>
                            <field name="title_en"/>
                            <field name="title_layout"/>
                            <field name="logo" widget="image" options="{'size': [0, 90]}"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ad_form_template_action" model="ir.actions.act_window">
        <field name="name">قوالب الاستمارات (ضبط الوثيقة)</field>
        <field name="res_model">ad.form.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
