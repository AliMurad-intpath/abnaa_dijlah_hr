<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_form_step_view_list" model="ir.ui.view">
        <field name="name">ad.form.step.list</field>
        <field name="model">ad.form.step</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"
                  decoration-info="state == 'pending'" decoration-muted="state == 'waiting'" create="0" edit="0" delete="0">
                <field name="record_name"/>
                <field name="name"/>
                <field name="approver_label"/>
                <field name="pending_since"/>
                <field name="state" widget="badge"/>
                <button name="action_open_record" type="object" string="فتح الاستمارة" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="ad_form_step_view_form" model="ir.ui.view">
        <field name="name">ad.form.step.form</field>
        <field name="model">ad.form.step</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_record" type="object" string="فتح الاستمارة" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting,pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="record_name"/>
                            <field name="name"/>
                            <field name="approver_id"/>
                            <field name="group_id"/>
                        </group>
                        <group>
                            <field name="pending_since"/>
                            <field name="action_date"/>
                            <field name="signed_by_name"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ad_form_step_search" model="ir.ui.view">
        <field name="name">ad.form.step.search</field>
        <field name="model">ad.form.step</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="approver_id"/>
                <filter name="pending" string="بانتظار الموافقة" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="تمت الموافقة" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="مرفوضة" domain="[('state', '=', 'rejected')]"/>
                <group>
                    <filter name="by_step" string="الخطوة" context="{'group_by': 'name'}"/>
                    <filter name="by_state" string="الحالة" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ad_form_step_action" model="ir.actions.act_window">
        <field name="name">كل خطوات الموافقة</field>
        <field name="res_model">ad.form.step</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
    <record id="ad_form_step_my_action" model="ir.actions.server">
        <field name="name">موافقات بانتظاري</field>
        <field name="model_id" ref="model_ad_form_step"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window', 'name': 'موافقات بانتظاري', 'res_model': 'ad.form.step',
    'view_mode': 'list,form', 'domain': model._pending_domain(),
}</field>
    </record>
    <record id="ad_form_reject_wizard_form" model="ir.ui.view">
        <field name="name">ad.form.reject.wizard.form</field>
        <field name="model">ad.form.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="step_name"/>
                    <field name="note" placeholder="اذكر سبب الرفض ليصل لمن انشأ الاستمارة"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="رفض الاستمارة" class="btn-danger"/>
                    <button string="الغاء" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <menuitem id="menu_ad_my_approvals" name="موافقات بانتظاري" parent="menu_ad_hr_root" sequence="5"
              action="ad_form_step_my_action"/>
    <menuitem id="menu_ad_all_approvals" name="كل خطوات الموافقة" parent="menu_ad_hr_config" sequence="40"
              action="ad_form_step_action"/>
</odoo>
