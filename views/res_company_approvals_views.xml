<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form_ad_approvals" model="ir.ui.view">
        <field name="name">res.company.form.ad.approvals</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="abnaa_dijlah_hr.res_company_view_form_ad"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ad_license_code']" position="after">
                <field name="ad_use_approvals"/>
                <field name="ad_reminder_enabled"/>
                <field name="ad_reminder_after_days" invisible="not ad_reminder_enabled"/>
                <field name="ad_reminder_repeat_days" invisible="not ad_reminder_enabled"/>
                <field name="ad_reminder_summary" invisible="not ad_reminder_enabled"/>
            </xpath>
        </field>
    </record>
    <record id="hr_employee_view_form_ad_signature" model="ir.ui.view">
        <field name="name">hr.employee.form.ad.signature</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="document_signature" widget="image" options="{'size': [0, 70]}"/>
            </xpath>
        </field>
    </record>
</odoo>
