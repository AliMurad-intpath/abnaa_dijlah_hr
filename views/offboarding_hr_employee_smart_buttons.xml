<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ad_smart_ad_hr_offboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.ad.smart.ad_hr_offboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ad_open_termination" type="object" class="oe_stat_button" icon="fa-sign-out" invisible="ad_termination_count == 0">
                    <field name="ad_termination_count" widget="statinfo" string="Termination orders"/>
                </button>
                <button name="action_ad_open_clearance" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="ad_clearance_count == 0">
                    <field name="ad_clearance_count" widget="statinfo" string="Clearance"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
