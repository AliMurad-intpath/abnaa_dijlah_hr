<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_employee_guarantee_view_list" model="ir.ui.view">
        <field name="name">ad.employee.guarantee.list</field>
        <field name="model">ad.employee.guarantee</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="guarantor_name"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="ad_employee_guarantee_view_form" model="ir.ui.view">
        <field name="name">ad.employee.guarantee.form</field>
        <field name="model">ad.employee.guarantee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_signed" type="object" string="تأشير موقّع ومختوم" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="اعادة الى مسودة" invisible="state == 'draft'"/>
                    <button name="action_ad_print" type="object" string="طباعة الاستمارة"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="المكفول">
                            <field name="employee_id"/>
                            <field name="capacity"/>
                            <field name="date"/>
                        </group>
                        <group string="الكفيل">
                            <field name="guarantor_name"/>
                            <field name="guarantor_phone"/>
                            <field name="guarantor_address"/>
                        </group>
                    </group>
                    <group string="الشهود والمشاور القانوني">
                        <group>
                            <field name="witness1"/>
                            <field name="witness2"/>
                        </group>
                        <group>
                            <field name="legal_advisor"/>
                            <field name="pledge_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_employee_guarantee_action" model="ir.actions.act_window">
        <field name="name">الكفالة والتعهد الخطي (ملحق)</field>
        <field name="res_model">ad.employee.guarantee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
