<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_work_site_view_list" model="ir.ui.view">
        <field name="name">ad.work.site.list</field>
        <field name="model">ad.work.site</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="governorate"/>
                <field name="supervisor_id"/>
                <field name="supervisor_mobile"/>
            </list>
        </field>
    </record>
    <record id="ad_work_site_view_form" model="ir.ui.view">
        <field name="name">ad.work.site.form</field>
        <field name="model">ad.work.site</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="governorate"/>
                            <field name="area"/>
                            <field name="supervisor_id"/>
                            <field name="supervisor_mobile"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_work_site_view_search" model="ir.ui.view">
        <field name="name">ad.work.site.search</field>
        <field name="model">ad.work.site</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="supervisor_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="ad_work_site_action" model="ir.actions.act_window">
        <field name="name">Work sites</field>
        <field name="res_model">ad.work.site</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
