<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_interview_view_list" model="ir.ui.view">
        <field name="name">ad.interview.list</field>
        <field name="model">ad.interview</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="recommendation == 'hire'" decoration-danger="recommendation == 'reject'">
                <field name="name"/><field name="date"/><field name="candidate_name"/><field name="job_title"/>
                <field name="overall_score"/><field name="recommendation"/><field name="ad_status" widget="badge" decoration-info="ad_status == 'pending'" decoration-success="ad_status == 'approved'" decoration-danger="ad_status == 'rejected'" decoration-muted="ad_status in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="ad_interview_view_form" model="ir.ui.view">
        <field name="name">ad.interview.form</field>
        <field name="model">ad.interview</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_hr" type="object" string="HR interview completed" class="btn-primary" invisible="ad_chain_on or state != 'draft'"/>
                    <button name="action_ops" type="object" string="Training / operations completed" class="btn-primary" invisible="ad_chain_on or state != 'hr'"/>
                    <button name="action_done" type="object" string="Approve recommendation" class="btn-primary" invisible="ad_chain_on or state != 'ops'"/>
                    <button name="action_ad_print" type="object" string="Preview PDF" invisible="ad_status in ('approved', 'cancel')"/>
                    <button name="action_ad_submit" type="object" string="Submit" class="btn-primary" invisible="not ad_can_submit"/>
                    <button name="action_ad_approve" type="object" string="Approve" class="btn-success" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_reject" type="object" string="Reject" class="btn-danger" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_print" type="object" string="Print Signed PDF" class="btn-primary" invisible="ad_status != 'approved'"/>
                    <button name="action_create_employee" type="object" string="Create employee" invisible="state != 'done' or recommendation != 'hire' or employee_id"/>
                    <button name="action_ad_cancel" type="object" string="Cancel" invisible="ad_status not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="ad_status != 'cancel'"/>
                    <field name="state" invisible="1"/><field name="ad_can_approve" invisible="1"/><field name="ad_chain_on" invisible="1"/><field name="ad_can_submit" invisible="1"/>
                    <field name="ad_status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/><field name="applicant_id"/><field name="candidate_name"/>
                            <field name="birth_date"/><field name="phone"/><field name="employee_id"/>
                        </group>
                        <group>
                            <field name="governorate"/><field name="area"/><field name="district"/>
                            <field name="interview_date"/><field name="job_title"/><field name="referral"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scores" name="scores">
                            <field name="score_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" column_invisible="1"/>
                                    <field name="criterion" readonly="1"/><field name="score"/><field name="comments"/>
                                </list>
                            </field>
                            <group>
                                <group string="Arabic"><field name="ar_read"/><field name="ar_write"/><field name="ar_speak"/></group>
                                <group string="English"><field name="en_read"/><field name="en_write"/><field name="en_speak"/></group>
                            </group>
                            <group><field name="overall_score"/></group>
                        </page>
                        <page string="Health" name="health">
                            <group>
                                <group>
                                    <field name="health_general"/><field name="weight"/><field name="height"/>
                                    <field name="q_medication"/><field name="q_tattoo"/><field name="q_planned_surgery"/><field name="q_care_program"/>
                                </group>
                                <group><field name="chronic_diseases"/></group>
                            </group>
                            <field name="surgery_ids"><list editable="bottom"><field name="name"/><field name="date"/></list></field>
                        </page>
                        <page string="Security" name="security">
                            <group>
                                <field name="q_party"/><field name="q_convicted"/><field name="q_pending_case"/>
                            </group>
                            <field name="reference_ids"><list editable="bottom"><field name="name"/><field name="relation"/><field name="phone"/></list></field>
                        </page>
                        <page string="Training" name="training">
                            <group>
                                <field name="t_weapon"/><field name="t_force_law"/><field name="t_armed_conflict"/><field name="t_search"/>
                            </group>
                        </page>
                        <page string="Recommendation" name="recommendation">
                            <group>
                                <group string="Decision">
                                    <field name="recommendation"/><field name="ack_date"/>
                                </group>
                                <group string="Withdrawal reasons" invisible="recommendation != 'withdraw'">
                                    <field name="w_salary"/><field name="w_duties"/><field name="w_hours"/>
                                    <field name="w_other_job"/><field name="w_mind"/><field name="w_other"/>
                                </group>
                                <group string="Reasons for not hiring" invisible="recommendation != 'reject'">
                                    <field name="r_qualif"/><field name="r_health"/><field name="r_security"/>
                                    <field name="r_training"/><field name="r_other"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_interview_action" model="ir.actions.act_window">
        <field name="name">Interview rating forms (AD-WI-FM-06-01)</field>
        <field name="res_model">ad.interview</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
