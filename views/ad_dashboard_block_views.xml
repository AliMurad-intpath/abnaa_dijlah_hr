<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_dashboard_block_list" model="ir.ui.view">
        <field name="name">ad.dashboard.block.list</field>
        <field name="model">ad.dashboard.block</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>
    <record id="ad_dashboard_block_form" model="ir.ui.view">
        <field name="name">ad.dashboard.block.form</field>
        <field name="model">ad.dashboard.block</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <h2><field name="name" readonly="1"/></h2>
                    <p class="text-muted">اترك المستخدمين والمجموعات فارغين ليظهر العنصر لكل من يفتح اللوحة.</p>
                    <group>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ad_dashboard_block_action" model="ir.actions.act_window">
        <field name="name">صلاحيات لوحة المتابعة</field>
        <field name="res_model">ad.dashboard.block</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
