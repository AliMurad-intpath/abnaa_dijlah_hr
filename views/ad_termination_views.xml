<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_termination_order_view_list" model="ir.ui.view">
        <field name="name">ad.termination.order.list</field>
        <field name="model">ad.termination.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="site_id"/>
                <field name="reason"/>
                <field name="effective_date"/>
                <field name="ad_status" widget="badge" decoration-info="ad_status == 'pending'" decoration-success="ad_status == 'approved'" decoration-danger="ad_status == 'rejected'" decoration-muted="ad_status in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="ad_termination_order_view_form" model="ir.ui.view">
        <field name="name">ad.termination.order.form</field>
        <field name="model">ad.termination.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="HR review" class="btn-primary" invisible="ad_chain_on or state != 'draft'"/>
                    <button name="action_approve" type="object" string="Managing director approval" class="btn-primary" invisible="ad_chain_on or state != 'hr'"/>
                    <button name="action_ad_print" type="object" string="Preview PDF" invisible="ad_status in ('approved', 'cancel')"/>
                    <button name="action_ad_submit" type="object" string="Submit" class="btn-primary" invisible="not ad_can_submit"/>
                    <button name="action_ad_approve" type="object" string="Approve" class="btn-success" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_reject" type="object" string="Reject" class="btn-danger" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_print" type="object" string="Print Signed PDF" class="btn-primary" invisible="ad_status != 'approved'"/>
                    <button name="action_open_clearance" type="object" string="Open clearance" invisible="not clearance_id"/>
                    <button name="action_ad_cancel" type="object" string="Cancel" invisible="ad_status not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="ad_status != 'cancel'"/>
                    <field name="state" invisible="1"/><field name="ad_can_approve" invisible="1"/><field name="ad_chain_on" invisible="1"/><field name="ad_can_submit" invisible="1"/>
                    <field name="ad_status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="capacity"/>
                            <field name="site_id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="reason"/>
                            <field name="disciplinary_ref"/>
                            <field name="clearance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvals" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_termination_order_action" model="ir.actions.act_window">
        <field name="name">Termination orders (AD-WI-FM-06-10)</field>
        <field name="res_model">ad.termination.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
