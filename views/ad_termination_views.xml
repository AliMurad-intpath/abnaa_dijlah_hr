<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_termination_order_view_list" model="ir.ui.view">
        <field name="name">ad.termination.order.list</field>
        <field name="model">ad.termination.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="site_id"/>
                <field name="reason"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ad_termination_order_view_form" model="ir.ui.view">
        <field name="name">ad.termination.order.form</field>
        <field name="model">ad.termination.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="مراجعة الموارد البشرية" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="موافقة المدير المفوض" class="btn-primary" invisible="state != 'hr'"/>
                    <button name="%(action_report_ad_termination)d" type="action" string="طباعة الاستمارة" invisible="state == 'cancel'"/>
                    <button name="action_open_clearance" type="object" string="فتح براءة الذمة" invisible="not clearance_id"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('approved', 'cancel')"/>
                    <button name="action_draft" type="object" string="اعادة الى مسودة" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,hr,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="capacity"/>
                            <field name="site_id"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="reason"/>
                            <field name="disciplinary_ref"/>
                            <field name="clearance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الموافقات" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_termination_order_action" model="ir.actions.act_window">
        <field name="name">اوامر انهاء الخدمات (AD-WI-FM-06-10)</field>
        <field name="res_model">ad.termination.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
