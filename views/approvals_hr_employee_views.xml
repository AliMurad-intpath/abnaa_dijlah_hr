<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ad_approvals" model="ir.ui.view">
        <field name="name">hr.employee.form.ad.approvals</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ad_open_approvals" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        invisible="ad_approval_count == 0">
                    <field name="ad_approval_count" widget="statinfo" string="طلبات الموافقة"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
