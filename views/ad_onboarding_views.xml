<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_onboarding_view_list" model="ir.ui.view">
        <field name="name">ad.onboarding.list</field>
        <field name="model">ad.onboarding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/><field name="date"/><field name="employee_id"/><field name="site_id"/>
                <field name="start_date"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ad_onboarding_view_form" model="ir.ui.view">
        <field name="name">ad.onboarding.form</field>
        <field name="model">ad.onboarding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_hr" type="object" string="اكتمل قسم الموارد البشرية" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_logistics" type="object" string="تم تجهيز الموظف" class="btn-primary" invisible="state != 'hr'"/>
                    <button name="action_site" type="object" string="تأييد مشرف الموقع" class="btn-primary" invisible="state != 'logistics'"/>
                    <button name="action_ops" type="object" string="تأييد العمليات" class="btn-primary" invisible="state != 'site'"/>
                    <button name="action_done" type="object" string="موافقة المدير المفوض" class="btn-primary" invisible="state != 'ops'"/>
                    <button name="action_ad_print" type="object" string="طباعة الاستمارة" invisible="state == 'cancel'"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" type="object" string="اعادة الى مسودة" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,hr,logistics,site,ops,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/><field name="employee_id"/><field name="appointment_id"/>
                            <field name="site_id"/><field name="start_date"/><field name="start_shift"/>
                        </group>
                        <group>
                            <field name="supervisor_name"/><field name="supervisor_mobile"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الموارد البشرية" name="hr">
                            <group>
                                <group>
                                    <field name="medical_done"/><field name="medical_letter" invisible="not medical_done"/>
                                    <field name="salary_done"/><field name="salary_letter" invisible="not salary_done"/>
                                    <field name="auth_done"/><field name="auth_letter" invisible="not auth_done"/>
                                </group>
                            </group>
                        </page>
                        <page string="اللوجستيك" name="logistics">
                            <group>
                                <group>
                                    <field name="issue_date"/><field name="shirt_size"/><field name="trouser_size"/>
                                    <field name="shoe_size"/><field name="has_pouch"/><field name="other_items"/>
                                </group>
                            </group>
                        </page>
                        <page string="العمليات" name="ops">
                            <group>
                                <group>
                                    <field name="ops_medical"/><field name="ops_salary"/><field name="ops_auth"/>
                                    <field name="training_done"/><field name="trainer_name"/>
                                </group>
                            </group>
                        </page>
                        <page string="الموافقات" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_onboarding_action" model="ir.actions.act_window">
        <field name="name">استمارات تاريخ مباشرة العمل (AD-WI-FM-06-03)</field>
        <field name="res_model">ad.onboarding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
