<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_onboarding_view_list" model="ir.ui.view">
        <field name="name">ad.onboarding.list</field>
        <field name="model">ad.onboarding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/><field name="date"/><field name="employee_id"/><field name="site_id"/>
                <field name="start_date"/><field name="ad_status" widget="badge" decoration-info="ad_status == 'pending'" decoration-success="ad_status == 'approved'" decoration-danger="ad_status == 'rejected'" decoration-muted="ad_status in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="ad_onboarding_view_form" model="ir.ui.view">
        <field name="name">ad.onboarding.form</field>
        <field name="model">ad.onboarding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_hr" type="object" string="HR section completed" class="btn-primary" invisible="ad_chain_on or state != 'draft'"/>
                    <button name="action_logistics" type="object" string="Employee equipped" class="btn-primary" invisible="ad_chain_on or state != 'hr'"/>
                    <button name="action_site" type="object" string="Site supervisor confirmation" class="btn-primary" invisible="ad_chain_on or state != 'logistics'"/>
                    <button name="action_ops" type="object" string="Operations confirmation" class="btn-primary" invisible="ad_chain_on or state != 'site'"/>
                    <button name="action_done" type="object" string="Managing director approval" class="btn-primary" invisible="ad_chain_on or state != 'ops'"/>
                    <button name="action_ad_print" type="object" string="Preview PDF" invisible="ad_status in ('approved', 'cancel')"/>
                    <button name="action_ad_submit" type="object" string="Submit" class="btn-primary" invisible="not ad_can_submit"/>
                    <button name="action_ad_approve" type="object" string="Approve" class="btn-success" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_reject" type="object" string="Reject" class="btn-danger" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_print" type="object" string="Print Signed PDF" class="btn-primary" invisible="ad_status != 'approved'"/>
                    <button name="action_ad_cancel" type="object" string="Cancel" invisible="ad_status not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="ad_status != 'cancel'"/>
                    <field name="state" invisible="1"/><field name="ad_can_approve" invisible="1"/><field name="ad_chain_on" invisible="1"/><field name="ad_can_submit" invisible="1"/>
                    <field name="ad_status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/><field name="employee_id"/><field name="appointment_id"/>
                            <field name="site_id"/><field name="start_date"/><field name="start_shift"/>
                        </group>
                        <group>
                            <field name="supervisor_name"/><field name="supervisor_mobile"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Human Resources" name="hr">
                            <group>
                                <group>
                                    <field name="medical_done"/><field name="medical_letter" invisible="not medical_done"/>
                                    <field name="salary_done"/><field name="salary_letter" invisible="not salary_done"/>
                                    <field name="auth_done"/><field name="auth_letter" invisible="not auth_done"/>
                                </group>
                            </group>
                        </page>
                        <page string="Logistics" name="logistics">
                            <group>
                                <group>
                                    <field name="issue_date"/><field name="shirt_size"/><field name="trouser_size"/>
                                    <field name="shoe_size"/><field name="has_pouch"/><field name="other_items"/>
                                </group>
                            </group>
                        </page>
                        <page string="Operations" name="ops">
                            <group>
                                <group>
                                    <field name="ops_medical"/><field name="ops_salary"/><field name="ops_auth"/>
                                    <field name="training_done"/><field name="trainer_name"/>
                                </group>
                            </group>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_onboarding_action" model="ir.actions.act_window">
        <field name="name">Start of work date forms (AD-WI-FM-06-03)</field>
        <field name="res_model">ad.onboarding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
