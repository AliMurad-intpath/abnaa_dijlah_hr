<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_appointment_order_view_form_approvals" model="ir.ui.view">
        <field name="name">ad.appointment.order.form.approvals</field>
        <field name="model">ad.appointment.order</field>
        <field name="inherit_id" ref="abnaa_dijlah_hr.ad_appointment_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ad_request_approval" type="object" string="طلب موافقة" class="btn-primary"
                        invisible="state not in ('draft',) or ad_approval_status in ('new', 'pending', 'approved')"/>
                <button name="action_ad_open_approval" type="object" string="طلب الموافقة" invisible="not ad_approval_request_id"/>
                <field name="ad_approval_request_id" invisible="1"/>
                <field name="ad_approval_status" widget="badge" invisible="not ad_approval_request_id"/>
            </xpath>
        </field>
    </record>
