<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ad_smart_ad_hr_employee_file" model="ir.ui.view">
        <field name="name">hr.employee.form.ad.smart.ad_hr_employee_file</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ad_open_guarantee" type="object" class="oe_stat_button" icon="fa-handshake-o" invisible="ad_guarantee_count == 0">
                    <field name="ad_guarantee_count" widget="statinfo" string="Guarantee"/>
                </button>
                <button name="action_ad_open_pledge" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="ad_pledge_count == 0">
                    <field name="ad_pledge_count" widget="statinfo" string="Pledges"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
