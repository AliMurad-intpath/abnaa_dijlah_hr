<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_appointment_order_view_list" model="ir.ui.view">
        <field name="name">ad.appointment.order.list</field>
        <field name="model">ad.appointment.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="job_title"/>
                <field name="site_id"/>
                <field name="nominal_salary"/>
                <field name="start_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="ad_appointment_order_view_form" model="ir.ui.view">
        <field name="name">ad.appointment.order.form</field>
        <field name="model">ad.appointment.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="HR review" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Managing director approval" class="btn-primary" invisible="state != 'hr'"/>
                    <button name="action_ad_print" type="object" string="Print form" invisible="state == 'cancel'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved', 'cancel')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,hr,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="employee_id"/>
                            <field name="job_title"/>
                            <field name="site_id"/>
                        </group>
                        <group>
                            <field name="nominal_salary"/>
                            <field name="allowance"/>
                            <field name="probation_months"/>
                            <field name="start_date"/>
                            <field name="interview_ref"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvals" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_appointment_order_view_search" model="ir.ui.view">
        <field name="name">ad.appointment.order.search</field>
        <field name="model">ad.appointment.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="site_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Awaiting managing director approval" name="hr" domain="[('state', '=', 'hr')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="ad_appointment_order_action" model="ir.actions.act_window">
        <field name="name">Appointment orders</field>
        <field name="res_model">ad.appointment.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ad_appointment_order_view_search"/>
    </record>
</odoo>
