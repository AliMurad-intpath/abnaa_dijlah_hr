<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ad_violation_type_view_list" model="ir.ui.view">
        <field name="name">ad.violation.type.list</field>
        <field name="model">ad.violation.type</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="number"/><field name="name"/><field name="active" column_invisible="1"/></list>
        </field>
    </record>
    <record id="ad_violation_type_action" model="ir.actions.act_window">
        <field name="name">Violation types</field>
        <field name="res_model">ad.violation.type</field>
        <field name="view_mode">list</field>
    </record>
    <record id="ad_discipline_view_list" model="ir.ui.view">
        <field name="name">ad.discipline.list</field>
        <field name="model">ad.discipline</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state in ('approved', 'acknowledged')">
                <field name="name"/><field name="date"/><field name="employee_id"/>
                <field name="repetition"/><field name="decision"/><field name="ad_status" widget="badge" decoration-info="ad_status == 'pending'" decoration-success="ad_status == 'approved'" decoration-danger="ad_status == 'rejected'" decoration-muted="ad_status in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>
    <record id="ad_discipline_view_form" model="ir.ui.view">
        <field name="name">ad.discipline.form</field>
        <field name="model">ad.discipline</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_hr" type="object" string="HR review" class="btn-primary" invisible="ad_chain_on or state != 'draft'"/>
                    <button name="action_ops" type="object" string="Operations approval" class="btn-primary" invisible="ad_chain_on or state != 'hr'"/>
                    <button name="action_approve" type="object" string="Managing director approval" class="btn-primary" invisible="ad_chain_on or state != 'ops'"/>
                    <button name="action_ad_print" type="object" string="Preview PDF" invisible="ad_status in ('approved', 'cancel')"/>
                    <button name="action_ad_submit" type="object" string="Submit" class="btn-primary" invisible="not ad_can_submit"/>
                    <button name="action_ad_approve" type="object" string="Approve" class="btn-success" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_reject" type="object" string="Reject" class="btn-danger" invisible="ad_status != 'pending' or not ad_can_approve"/>
                    <button name="action_ad_print" type="object" string="Print Signed PDF" class="btn-primary" invisible="ad_status != 'approved'"/>
                    <button name="action_acknowledge" type="object" string="Employee acknowledgment of receipt" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_ad_cancel" type="object" string="Cancel" invisible="ad_status not in ('draft', 'pending', 'rejected')"/>
                    <button name="action_draft" type="object" string="Reset to draft" invisible="ad_status != 'cancel'"/>
                    <field name="state" invisible="1"/><field name="ad_can_approve" invisible="1"/><field name="ad_chain_on" invisible="1"/><field name="ad_can_submit" invisible="1"/>
                    <field name="ad_status" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/><field name="employee_id"/><field name="job_title"/><field name="employee_no"/>
                        </group>
                        <group>
                            <field name="repetition"/><field name="decision"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Violations"><field name="violation_ids" widget="many2many_tags" nolabel="1"/></group>
                    <group string="Decision">
                        <group invisible="decision != 'suspension'">
                            <field name="date_from"/><field name="date_to"/><field name="total_days"/>
                        </group>
                        <group invisible="decision != 'deduction'">
                            <field name="deduction_type"/><field name="deduction_amount"/><field name="deduction_from"/>
                        </group>
                        <group invisible="decision != 'termination'">
                            <field name="termination_from"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approvals" name="approvals">
                            <field name="signature_ids" readonly="1">
                                <list><field name="step"/><field name="user_id"/><field name="date"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="ad_discipline_action" model="ir.actions.act_window">
        <field name="name">Penalties forms (AD-HR-FM-10)</field>
        <field name="res_model">ad.discipline</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
