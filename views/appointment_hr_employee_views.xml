<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_ad_appointment" model="ir.ui.view">
        <field name="name">hr.employee.form.ad.appointment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="abnaa_dijlah_hr.hr_employee_view_form_ad"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ad_work_area']" position="after">
                <field name="ad_nominal_salary"/>
                <field name="ad_site_allowance"/>
                <field name="ad_start_date"/>
                <field name="ad_probation_end"/>
            </xpath>
        </field>
    </record>
</odoo>
