<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="abnaa_dijlah_hr.AdDashboard">
        <div t-att-class="'ad-workspace ' + (this.state.dark ? 'ad-dark ' : '') + (this.state.office ? 'ad-office' : '')" dir="rtl" lang="ar">
            <aside class="ad-sidebar">
                <div class="ad-brand">Abnaa Dijlah<span> /</span> HR</div>
                <div class="ad-brand-sub">أبناء دجلة للخدمات الأمنية</div>
                <div class="ad-nav-label">استمارات الموارد البشرية</div>
                <nav t-if="this.state.data and this.state.data.show.nav_forms">
                    <button class="active"><span class="ad-nav-dot"/><span>نظرة عامة</span></button>
                    <button t-foreach="this.state.data.tiles" t-as="tile" t-key="tile.model" t-on-click="() => this.openTile(tile)">
                        <span class="ad-nav-dot"/><span class="ad-nav-text" t-out="tile.title"/>
                        <span t-if="tile.open" class="ad-nav-count" t-out="tile.open"/>
                        <span t-if="this.state.edit" class="ad-lock" role="button" t-on-click="(ev) => this.editAccess(ev, tile.block)">&#128274;</span>
                    </button>
                </nav>
                <div class="ad-sidebar-footer"><span class="ad-status-dot"/> بيانات اودو المباشرة</div>
            </aside>

            <main class="ad-main">
                <header class="ad-topbar">
                    <div>
                        <div class="ad-eyebrow">لوحة المتابعة</div>
                        <h1>استمارات الموارد البشرية</h1>
                        <p class="ad-greeting" t-if="this.state.data">
                            <span class="ad-greet-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon(this.greetIcon)" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                            <span t-out="this.greeting"/> · <span t-out="this.dateLabel"/>
                        </p>
                    </div>
                    <div class="ad-actions">
                        <label class="ad-auto" title="تحديث تلقائي كل 5 دقائق">
                            <input type="checkbox" t-att-checked="this.state.auto" t-on-change="(ev) => this.setAuto(ev.target.checked)"/>
                            <span>تحديث كل 5 دقائق</span>
                        </label>
                        <button t-if="this.state.data and this.state.data.can_edit_access" t-att-class="'ad-btn ' + (this.state.edit ? 'ad-primary' : '')" t-on-click="() => this.toggleEdit()">&#128274; <t t-out="this.state.edit ? 'انهاء تعديل الصلاحيات' : 'تعديل الصلاحيات'"/></button>
                        <button class="ad-btn ad-theme" t-on-click="() => this.toggleTheme()" title="الوضع الليلي/النهاري">
                            <svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon(this.state.dark ? 'sun' : 'moon')" t-as="d" t-key="d_index" t-att-d="d"/></svg>
                        </button>
                        <button class="ad-btn" t-on-click="() => this.toggleOffice()">
                            <svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('monitor')" t-as="d" t-key="d_index" t-att-d="d"/></svg>
                            <t t-out="this.state.office ? 'خروج من شاشة المكتب' : 'شاشة المكتب'"/>
                        </button>
                        <button class="ad-btn ad-primary" t-on-click="() => this.reload()" t-att-disabled="this.state.loading">
                            <svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('refresh')" t-as="d" t-key="d_index" t-att-d="d"/></svg> تحديث
                        </button>
                    </div>
                </header>

                <div t-if="this.state.error" class="ad-alert" role="alert">تعذر تحميل البيانات: <span dir="ltr" t-out="this.state.errorMessage"/></div>
                <div t-if="this.state.loading and !this.state.data" class="ad-empty">جاري التحميل...</div>

                <t t-if="this.state.data">
                    <!-- KPI cards -->
                    <section class="ad-grid ad-kpis" t-att-aria-busy="this.state.loading ? 'true' : 'false'">
                        <article t-foreach="this.state.data.kpis" t-as="k" t-key="k.key"
                                 t-att-class="'ad-panel ad-block ad-kpi ad-kind-' + k.kind + (k.model ? ' ad-click' : '')"
                                 t-on-click="() => this.openKpi(k)">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon(k.icon)" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3 t-out="k.label"/>
                                <button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'kpi_' + k.key)">&#128274;</button>
                            </div>
                            <div class="ad-kpi-value" t-out="k.value"/>
                        </article>
                    </section>

                    <!-- Create directly from the dashboard -->
                    <section t-if="this.state.data.show.panel_create and this.createGroups.length" class="ad-panel ad-create">
                        <div class="ad-panel-head"><h3>انشاء سريع</h3><span class="ad-block-type">من هنا مباشرة</span><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'panel_create')">&#128274;</button></div>
                        <div t-foreach="this.createGroups" t-as="g" t-key="g.title" class="ad-create-group">
                            <div class="ad-create-title" t-out="g.title"/>
                            <div class="ad-create-btns">
                                <button t-foreach="g.items" t-as="item" t-key="item.key" class="ad-btn ad-create-btn"
                                        t-on-click="() => this.createNew(item)">
                                    <svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon(item.icon)" t-as="d" t-key="d_index" t-att-d="d"/></svg>
                                    <span t-out="item.label"/>
                                    <t t-if="this.state.edit"><span class="ad-lock" role="button" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, item.block)">&#128274;</span></t>
                                    <span class="ad-create-plus"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('plus')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                </button>
                            </div>
                        </div>
                    </section>

                    <section t-if="this.state.data.show.panel_alerts or this.state.data.show.panel_recent" class="ad-grid ad-two">
                        <article t-if="this.state.data.show.panel_alerts" class="ad-panel ad-block ad-kind-pie">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('alert')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3>تنبيهات تحتاج اجراء</h3><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'panel_alerts')">&#128274;</button>
                            </div>
                            <div t-if="!this.state.data.alerts.length" class="ad-empty">لا توجد تنبيهات.</div>
                            <button t-foreach="this.state.data.alerts" t-as="a" t-key="a_index" t-att-class="'ad-alert-row ad-lvl-' + a.level"
                                    t-on-click="() => this.openAlert(a)">
                                <span class="ad-dot"/><span t-out="a.text"/>
                                <span t-if="this.state.edit" class="ad-lock" role="button" t-on-click="(ev) => this.editAccess(ev, a.block)">&#128274;</span>
                            </button>
                        </article>

                        <article t-if="this.state.data.show.panel_recent" class="ad-panel ad-block ad-kind-table">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('table')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3>اخر الاستمارات</h3><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'panel_recent')">&#128274;</button>
                            </div>
                            <div t-if="!this.state.data.recent.length" class="ad-empty">لا توجد استمارات بعد.</div>
                            <div class="ad-table-wrap" t-else="">
                                <table>
                                    <thead><tr><th>الاستمارة</th><th>الرقم</th><th>الحالة</th><th>التاريخ</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="this.state.data.recent" t-as="r" t-key="r.model + r.id" class="ad-click" t-on-click="() => this.openRecord(r)">
                                            <td t-out="r.title"/><td dir="ltr" t-out="r.name"/><td t-out="r.state"/><td dir="ltr" t-out="this.stamp(r.when)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </article>
                    </section>

                    <section class="ad-grid ad-three">
                        <article t-if="this.state.data.show.chart_trend" class="ad-panel ad-block ad-kind-column">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('column')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3>الاستمارات المنشأة - اخر 6 اشهر</h3><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'chart_trend')">&#128274;</button>
                            </div>
                            <div class="ad-cols" dir="ltr">
                                <div t-foreach="this.state.data.trend" t-as="t" t-key="t.label" class="ad-col">
                                    <span class="ad-col-val" t-out="t.count"/>
                                    <div class="ad-col-bar" t-att-style="'height:' + this.colHeight(t.count) + '%'"/>
                                    <span class="ad-col-lbl" t-out="t.label"/>
                                </div>
                            </div>
                        </article>

                        <article t-if="this.state.data.show.chart_types" class="ad-panel ad-block ad-kind-doughnut">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('doughnut')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3>حسب نوع الاستمارة</h3><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'chart_types')">&#128274;</button>
                            </div>
                            <t t-set="dn" t-value="this.doughnut"/>
                            <div t-if="!dn.total" class="ad-empty">لا توجد بيانات.</div>
                            <t t-else="">
                                <svg viewBox="0 0 120 120" class="ad-round" role="img" aria-label="الاستمارات حسب النوع">
                                    <circle t-foreach="dn.slices" t-as="s" t-key="s.model" cx="60" cy="60" r="38" fill="none"
                                            t-att-stroke="s.color" stroke-width="18" pathLength="100"
                                            t-att-stroke-dasharray="s.dash" t-att-stroke-dashoffset="s.offset" transform="rotate(-90 60 60)"/>
                                    <text x="60" y="66" text-anchor="middle" class="ad-donut-total" t-out="dn.total"/>
                                </svg>
                                <ul class="ad-legend">
                                    <li t-foreach="dn.slices" t-as="s" t-key="s.model" class="ad-click" t-on-click="() => this.openAll(s.tile)">
                                        <span class="ad-swatch" t-att-style="'background:' + s.color"/>
                                        <span class="ad-legend-label" t-out="s.title"/><bdi dir="ltr" t-out="s.count"/>
                                    </li>
                                </ul>
                            </t>
                        </article>

                        <article t-if="this.state.data.show.chart_sites" class="ad-panel ad-block ad-kind-bar">
                            <div class="ad-panel-head">
                                <span class="ad-block-icon"><svg class="ad-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path t-foreach="this.icon('bar')" t-as="d" t-key="d_index" t-att-d="d"/></svg></span>
                                <h3>الموظفون حسب موقع العمل</h3><button t-if="this.state.edit" class="ad-lock" title="تعديل الصلاحيات" t-on-click="(ev) => this.editAccess(ev, 'chart_sites')">&#128274;</button>
                            </div>
                            <div t-if="!this.state.data.sites.length" class="ad-empty">لا توجد مواقع معينة.</div>
                            <div t-foreach="this.state.data.sites" t-as="s" t-key="s.id" class="ad-bar-row ad-click" t-on-click="() => this.openSite(s)">
                                <div><span t-out="s.name"/><bdi dir="ltr" t-out="s.count"/></div>
                                <div class="ad-bar-track"><span t-att-style="'width:' + this.barWidth(s.count) + '%'"/></div>
                            </div>
                        </article>
                    </section>
                </t>
            </main>
        </div>
    </t>
</templates>
