<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ad_termination_order" model="ir.sequence">
        <field name="name">Termination of services - AD</field>
        <field name="code">ad.termination.order</field>
        <field name="prefix">TO/%(year)s/</field>
