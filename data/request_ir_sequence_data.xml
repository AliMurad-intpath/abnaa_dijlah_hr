<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ad_request" model="ir.sequence">
        <field name="name">HR requests - AD (one number per year)</field>
        <field name="code">ad.request</field>
        <field name="prefix">AD/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
