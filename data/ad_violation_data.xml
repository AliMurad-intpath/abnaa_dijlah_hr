<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="violation_01" model="ad.violation.type">
        <field name="number">1</field>
        <field name="name">الغياب عن الدوام الرسمي بدون تبليغ مسبق</field>
    </record>
    <record id="violation_02" model="ad.violation.type">
        <field name="number">2</field>
        <field name="name">مخالفة القوانين والأنظمة والآداب الخاصة والعامة</field>
    </record>
    <record id="violation_03" model="ad.violation.type">
        <field name="number">3</field>
        <field name="name">الحضور الى العمل متأخر او تركه مبكر دون اذن</field>
    </record>
    <record id="violation_04" model="ad.violation.type">
        <field name="number">4</field>
        <field name="name">التعامل بأسلوب غير لائق مع المسؤول المباشر</field>
    </record>
    <record id="violation_05" model="ad.violation.type">
        <field name="number">5</field>
        <field name="name">عدم العودة من الاجازة في اليوم المحدد</field>
    </record>
