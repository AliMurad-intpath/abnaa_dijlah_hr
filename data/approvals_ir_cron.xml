    <record id="ir_cron_ad_approval_remind" model="ir.cron">
        <field name="name">استمارات AD: تذكير المعتمدين بالموافقات المعلقة</field>
        <field name="model_id" ref="approvals.model_approval_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_ad_remind()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
