<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_ad_approval_sync" model="ir.cron">
        <field name="name">استمارات AD: مزامنة طلبات الموافقة</field>
        <field name="model_id" ref="approvals.model_approval_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_ad_sync()</field>
        <field name="interval_number">15</field>
