<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_ad_form_remind" model="ir.cron">
        <field name="name">AD Forms: remind approvers of pending approvals</field>
        <field name="model_id" ref="model_ad_form_step"/>
        <field name="state">code</field>
        <field name="code">model._cron_ad_remind()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <!-- load the blank PDFs, printed fields and approval stages (idempotent) -->
    <function model="ad.form.template" name="_ad_seed_engine"/>
    <!-- the one translation path: ar.po into the database (every install and upgrade) -->
    <function model="ad.form.template" name="_ad_apply_arabic"/>
</odoo>
